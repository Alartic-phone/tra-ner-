# ---------------------------------------------------------------------------
# Configuration — copier ce fichier vers .env et compléter.
# Le fichier .env est ignoré par git : il ne doit JAMAIS être commité.
# ---------------------------------------------------------------------------

# Base de données
# SQLite en local. Pour PostgreSQL, remplacer par une URL postgresql:// ET
# changer le `provider` dans prisma/schema.prisma (voir le README).
DATABASE_URL="file:./dev.db"

# Application sans authentification (mono-utilisateur, usage local ou réseau
# de confiance). Ne PAS exposer sur Internet sans remettre une protection en
# place devant (reverse proxy avec auth, VPN, etc.).

# Clé de chiffrement des jetons Strava stockés en base — 32 octets en
# hexadécimal. Générer avec :  openssl rand -hex 32
# La CHANGER rend les jetons Strava illisibles (il faudra reconnecter Strava).
ENCRYPTION_KEY=""

# URL publique de l'application, si elle est exposée sur Internet.
# Renseignée  -> le webhook Strava devient possible (synchronisation temps réel).
# Vide        -> synchronisation par le bouton « Synchroniser » et par le cron.
PUBLIC_URL=""

# ---------------------------------------------------------------------------
# Strava — https://www.strava.com/settings/api
# Voir la procédure détaillée dans le README (§Créer l'application Strava).
# ---------------------------------------------------------------------------
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# Jeton arbitraire servant à valider l'abonnement au webhook Strava.
# Générer avec :  openssl rand -hex 16
# Utile uniquement si PUBLIC_URL est renseignée.
STRAVA_WEBHOOK_VERIFY_TOKEN=""

# ---------------------------------------------------------------------------
# Génération des plans — API Claude (https://console.anthropic.com/)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Modèle utilisé pour la génération et l'adaptation des plans.
ANTHROPIC_MODEL="claude-opus-5"

# ---------------------------------------------------------------------------
# Fond de carte des tracés GPS — tuiles vectorielles MapTiler (maptiler.com,
# gratuit : compte → Cloud → API Keys), rendues via MapLibre GL JS. L'API
# Static Maps (image pré-rendue) du même fournisseur est payante et n'est
# pas utilisée. Clé vide = tracé seul en SVG.
# ---------------------------------------------------------------------------
MAPTILER_API_KEY=""

# Fuseau horaire de référence pour tous les calculs de jours calendaires.
TZ="Europe/Paris"

# Secret partagé permettant à la tâche planifiée de déclencher la
# synchronisation Strava sans session (utilisé par docker compose).
# Générer avec :  openssl rand -hex 16
CRON_SECRET=""
