{
  "name": "alartic",
  "private": true,
  "version": "0.1.0",
  "description": "Site ALARTIC — e-commerce privacy-first (monorepo)",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "preview:web": "npm run preview -w apps/web",
    "typecheck:web": "npm run typecheck -w apps/web",
    "audit": "npm audit --audit-level=critical",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "eslint-config-prettier": "10.1.8"
  }
}
