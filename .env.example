# ALARTIC — Variables d'environnement (DEV uniquement)
#
# Copier ce fichier en .env et adapter les valeurs.
# .env est gitignored : il ne sera jamais commité (vérif gitleaks en pre-commit).
#
# En PROD : ces variables seront fournies par le gestionnaire de secrets
# Infomaniak (J5), JAMAIS hardcodées dans un fichier.

# ───────── PostgreSQL (consommé par docker-compose.yml et le binaire Rust) ─────────
POSTGRES_DB=alartic_dev
POSTGRES_USER=alartic
POSTGRES_PASSWORD=dev_only_change_me

# URL complète, utilisée par sqlx pour la compilation des requêtes
DATABASE_URL=postgres://alartic:dev_only_change_me@localhost:5433/alartic_dev

# ───────── SMTP (Mailpit en dev — Infomaniak Mail en prod) ─────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ALARTIC <noreply@alartic.fr>"
SMTP_TLS=false  # en prod : true avec STARTTLS Infomaniak
#
# Valeurs prod Infomaniak (cf. infra/INFOMANIAK_MAIL.md) :
#   SMTP_HOST=mail.infomaniak.com
#   SMTP_PORT=587
#   SMTP_USER=noreply@alartic.fr
#   SMTP_PASSWORD=<mot de passe applicatif généré dans le Manager>
#   SMTP_TLS=true

# ───────── Payplug (CDC §9.1 — tunnel d'achat) ─────────
# Clé secrète Payplug. sk_test_* en dev (aucun débit réel), sk_live_* en prod.
# En prod : viendra du gestionnaire de secrets Infomaniak (jamais ici).
PAYPLUG_SECRET_KEY=sk_test_REPLACE_ME

# Chemin vers le catalogue Decap (parsing au démarrage pour les prix).
# Par défaut : résolu relativement à apps/api/ vers apps/web/content/products.
# En prod (image distroless) : on copie le dossier à côté du binaire et on
# pointe ALARTIC_PRODUCTS_DIR=/app/content/products.
# ALARTIC_PRODUCTS_DIR=

# ───────── Application ─────────
# Clé maîtresse pour AES-256-GCM (CDC §10.4). 32 bytes = 64 hex chars.
# DEV : générer avec `openssl rand -hex 32` et coller ci-dessous.
# PROD : viendra du gestionnaire de secrets Infomaniak (jamais ici).
ALARTIC_MASTER_KEY=REPLACE_ME_64_HEX_CHARS_OPENSSL_RAND_HEX_32

# HMAC key pour le hash déterministe email (recherche sans déchiffrer)
ALARTIC_EMAIL_HMAC_KEY=REPLACE_ME_64_HEX_CHARS_OPENSSL_RAND_HEX_32

# Port d'écoute du binaire Rust
ALARTIC_PORT=3000

# Niveau de log (off, error, warn, info, debug, trace)
RUST_LOG=info,alartic_api=debug,sqlx=warn

# CORS pour dev front sur port distinct (Astro 4321 → Axum 3000). Laisser
# vide en prod : Caddy fait le reverse proxy, tout passe par le même domaine.
ALARTIC_CORS_ORIGIN=http://localhost:4321

# URL externe de l'API (utilisée pour construire l'URL absolue du webhook
# Payplug : `{ALARTIC_BASE_URL}/payments/payplug/webhook`). En dev local, le
# webhook n'est pas joignable depuis le cloud Payplug — on passe par un
# cloudflared quick tunnel (`cloudflared tunnel --url localhost:3000`) et on
# colle l'URL trycloudflare ici. En prod : `https://alartic.fr` derrière Caddy.
ALARTIC_BASE_URL=http://localhost:3000

# URL externe du front (utilisée pour rediriger l'utilisateur après le clic
# sur un magic link). En prod (Caddy same-origin), même valeur que
# ALARTIC_BASE_URL — peut être omis, fallback automatique.
ALARTIC_FRONT_URL=http://localhost:4321

# ───────── Identité légale du vendeur (mentions facture obligatoires) ─────────
# CGI art. 242 nonies A. Ces valeurs apparaissent sur chaque facture PDF
# générée (entête, footer, mentions). En dev : placeholders OK. En prod : à
# remplir avec les vraies infos avant la première vente facturée.
ALARTIC_SELLER_NAME="ALARTIC — Thomas BEHAGUE EI"
ALARTIC_SELLER_ADDRESS_LINE1="[Adresse à compléter]"
ALARTIC_SELLER_ADDRESS_LINE2="France"
ALARTIC_SELLER_SIRET="[SIRET à compléter]"
# Optionnel — laisser vide si micro-entrepreneur en franchise art. 293 B CGI.
ALARTIC_SELLER_TVA_INTRA=
ALARTIC_SELLER_EMAIL=contact@alartic.fr
# Optionnel
ALARTIC_SELLER_PHONE=
ALARTIC_SELLER_WEBSITE=alartic.fr

# ───────── Front public (Astro) ─────────
# URL de base pour les liens absolus (sitemap, OG)
PUBLIC_SITE_URL=http://localhost:4321
