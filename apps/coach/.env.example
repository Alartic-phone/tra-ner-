# ---------------------------------------------------------------------------
# Configuration — copier ce fichier vers .env et compléter.
# Le fichier .env est ignoré par git : il ne doit JAMAIS être commité.
# ---------------------------------------------------------------------------

# Base de données
# SQLite en local. Pour PostgreSQL, remplacer par une URL postgresql:// ET
# changer le `provider` dans prisma/schema.prisma (voir le README).
DATABASE_URL="file:./dev.db"

# Accès à l'application
# Mot de passe unique (14 caractères minimum) + cookie de session signé
# HMAC-SHA256, vérifiés par le middleware (src/middleware.ts) sur toute
# route sauf /login, /api/auth/login, le webhook Strava et /api/strava/sync.
# Absents tous les deux -> pas d'authentification, refusé au démarrage dès
# que PUBLIC_URL est renseignée (voir plus bas).
#
# Générer avec :
#   openssl rand -base64 18   # -> APP_PASSWORD (12 caractères minimum)
#   openssl rand -hex 32      # -> SESSION_SECRET
APP_PASSWORD=""
SESSION_SECRET=""

# Clé de chiffrement — 32 octets en hexadécimal.
# Générer avec :  openssl rand -hex 32
# Sert à chiffrer les jetons Strava en base. La CHANGER les rend illisibles
# (il faudra reconnecter Strava).
ENCRYPTION_KEY=""

# URL publique de l'application, si elle est exposée sur Internet.
# Renseignée  -> le webhook Strava devient possible (synchronisation temps réel).
# Vide        -> synchronisation par le bouton « Synchroniser » et par le cron.
PUBLIC_URL=""

# ---------------------------------------------------------------------------
# Strava — https://www.strava.com/settings/api
# Voir la procédure détaillée dans le README (§Créer l'application Strava).
# ---------------------------------------------------------------------------
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# Jeton arbitraire servant à valider l'abonnement au webhook Strava.
# Générer avec :  openssl rand -hex 16
# Utile uniquement si PUBLIC_URL est renseignée.
STRAVA_WEBHOOK_VERIFY_TOKEN=""

# ---------------------------------------------------------------------------
# Génération des plans — API Claude (https://console.anthropic.com/)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Modèle utilisé pour la génération et l'adaptation des plans.
ANTHROPIC_MODEL="claude-opus-5"

# ---------------------------------------------------------------------------
# Fond de carte des tracés GPS — tuiles vectorielles MapTiler (maptiler.com,
# gratuit : compte → Cloud → API Keys), rendues via MapLibre GL JS. L'API
# Static Maps (image pré-rendue) du même fournisseur est payante et n'est
# pas utilisée. Clé vide = tracé seul en SVG.
# ---------------------------------------------------------------------------
MAPTILER_API_KEY=""

# ---------------------------------------------------------------------------
# Pack de photos d'ambiance — script ponctuel scripts/fetch-photos.ts
# (npm run photos:fetch), UNE SEULE fois, résultat versionné dans
# public/photos. Aucune des deux n'est lue à l'exécution de l'app : à mettre
# de préférence dans .env.local, jamais commitée, et seulement le temps du
# script. Renseigner l'une des deux (Unsplash prioritaire si les deux sont
# présentes).
# ---------------------------------------------------------------------------
# https://unsplash.com/developers — application gratuite, "Access Key".
UNSPLASH_ACCESS_KEY=""
# https://www.pexels.com/api/ — inscription gratuite.
PEXELS_API_KEY=""

# Fuseau horaire de référence pour tous les calculs de jours calendaires.
TZ="Europe/Paris"

# Secret partagé permettant à un appelant externe (cron distant, reverse
# proxy) de déclencher la synchronisation Strava via /api/strava/sync
# (utilisé par docker compose). Générer avec : openssl rand -hex 16
CRON_SECRET=""
