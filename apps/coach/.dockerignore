node_modules
.next
out

# Base de données locale et sauvegardes — jamais dans l'image, la base de
# production vit dans le volume Fly, pas dans le build.
prisma/dev.db
prisma/*.db
backups/

# Environnement — les vraies valeurs viennent des secrets/env Fly, jamais
# du fichier local.
.env
.env.local
.env.*.local

# Imports bruts, jamais versionnés.
data/
uploads/

.cache/
.DS_Store
*.log
.tmp-audit*
