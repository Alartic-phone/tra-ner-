---
import Base from "../layouts/Base.astro";
import Container from "../components/atoms/Container.astro";
import Card from "../components/atoms/Card.astro";
import Header from "../components/molecules/Header.astro";
import Footer from "../components/molecules/Footer.astro";
import TrustPillars from "../components/molecules/TrustPillars.astro";
import CtaBanner from "../components/molecules/CtaBanner.astro";

const pillars = [
  {
    icon: "lock" as const,
    title: "Chiffrement systématique",
    description: "TLS 1.3 en transit. AES-256-GCM applicatif sur les champs sensibles. LUKS au repos sur la partition PostgreSQL. Sauvegardes chiffrées avec une clé indépendante.",
    color: "brand" as const,
  },
  {
    icon: "shield" as const,
    title: "Surface d'attaque minimale",
    description: "Front statique (Astro SSG), aucune surface dynamique côté visiteur. Back en Rust (sécurité mémoire native). Aucune dépendance JavaScript tierce.",
    color: "ink" as const,
  },
  {
    icon: "user-check" as const,
    title: "Authentification durcie",
    description: "Magic link custom Rust (jeton ≤ 15 min, usage unique, comparaison constant-time, rate limiting). 2FA TOTP obligatoire pour le back-office admin.",
    color: "accent" as const,
  },
];
---

<Base
  title="Politique de sécurité"
  description="Engagements techniques, programme de divulgation responsable, clé PGP."
>
  <Header slot="header" />

  <section class="hero">
    <Container size="lg">
      <div data-anim="hero-stagger">
        <h1 class="hero__title">La sécurité n'est pas un argument. C'est l'architecture.</h1>
        <p class="hero__lead">
          Cette page liste nos engagements techniques vérifiables et explique comment nous
          signaler une vulnérabilité. Aucune marketing-speak — uniquement ce que nous faisons
          et comment vous pouvez le vérifier.
        </p>
      </div>
    </Container>
  </section>

  <!-- VDP — Vulnerability Disclosure Program -->
  <section class="section section--surface">
    <Container size="md">
      <header class="section__header">
        <h2 class="section__title">Signaler une vulnérabilité.</h2>
        <p class="section__lead">
          Si vous découvrez une faille de sécurité affectant ce site ou nos services, nous vous
          demandons de la signaler en privé avant toute divulgation publique.
        </p>
      </header>

      <Card variant="outlined" padding="lg" class="vdp-card">
        <div class="vdp-card__row">
          <span class="vdp-card__label">Contact</span>
          <span class="vdp-card__value">
            <a href="mailto:security@alartic.fr">security@alartic.fr</a>
          </span>
        </div>
        <div class="vdp-card__row">
          <span class="vdp-card__label">Engagement de réponse</span>
          <span class="vdp-card__value">Sous <strong>72 h ouvrées</strong></span>
        </div>
        <div class="vdp-card__row">
          <span class="vdp-card__label">Coordination</span>
          <span class="vdp-card__value">Embargo sur la divulgation publique jusqu'à correction</span>
        </div>
        <div class="vdp-card__row">
          <span class="vdp-card__label">Reconnaissance</span>
          <span class="vdp-card__value">Mention au Hall of Fame ci-dessous, si vous le souhaitez</span>
        </div>
      </Card>
    </Container>
  </section>

  <!-- Safe Harbor -->
  <section class="section">
    <Container size="md">
      <h2 class="section__title section__title--sm">Engagement Safe Harbor.</h2>
      <p class="prose">
        Toute personne qui effectue de la recherche en sécurité <strong>de bonne foi</strong>,
        en respectant les règles ci-dessous, ne fera l'objet <strong>d'aucune poursuite
        civile ou pénale</strong> de notre part. Nous nous engageons explicitement à ne pas
        invoquer les articles 323-1 et suivants du Code pénal (atteintes aux systèmes de
        traitement automatisé de données) à votre encontre dans ce cadre.
      </p>

      <h3 class="prose-h3">Règles à respecter</h3>
      <ul class="prose-list">
        <li>Ne pas exfiltrer, dégrader ni modifier de données utilisateur.</li>
        <li>Ne pas effectuer d'attaque par déni de service.</li>
        <li>Ne pas pivoter vers des systèmes externes (Infomaniak, Payplug, PayPal).</li>
        <li>Ne pas divulguer publiquement avant correction (sauf après 90 j sans réponse).</li>
        <li>Limiter votre recherche au strict nécessaire à la démonstration.</li>
      </ul>
    </Container>
  </section>

  <!-- Clé PGP -->
  <section class="section section--surface">
    <Container size="md">
      <h2 class="section__title section__title--sm">Clé PGP — chiffrement E2E.</h2>
      <p class="prose">
        Pour tout signalement contenant une vulnérabilité 0-day ou une information sensible,
        chiffrez votre message à l'adresse <code>security@alartic.fr</code> avec la clé
        publique ci-dessous.
      </p>

      <Card variant="outlined" padding="lg" class="pgp-card">
        <dl class="pgp-meta">
          <div>
            <dt>Empreinte</dt>
            <dd><code><em>[à compléter — empreinte SHA-256 de la clé PGP générée par Thomas avant MEP]</em></code></dd>
          </div>
          <div>
            <dt>Algorithme</dt>
            <dd>Ed25519 + Curve25519 (signature + chiffrement)</dd>
          </div>
          <div>
            <dt>Date de création</dt>
            <dd><em>[à compléter à la génération]</em></dd>
          </div>
          <div>
            <dt>Téléchargement</dt>
            <dd>
              <a href="/security/alartic-security.asc" data-print-hide>alartic-security.asc</a>
              <em> (à publier avant MEP)</em>
            </dd>
          </div>
        </dl>
      </Card>
    </Container>
  </section>

  <!-- Engagements techniques -->
  <section class="section">
    <Container size="lg">
      <header class="section__header">
        <h2 class="section__title">Engagements techniques.</h2>
        <p class="section__lead">
          Vérifiables, mesurables, auditables.
        </p>
      </header>
      <TrustPillars pillars={pillars} />
    </Container>
  </section>

  <!-- Audit & objectifs externes -->
  <section class="section section--surface">
    <Container size="md">
      <h2 class="section__title section__title--sm">Audit externe.</h2>
      <p class="prose">
        Le module <strong>magic link</strong> fait l'objet d'une revue de code croisée avant
        chaque mise en ligne (CDC §5.7). Un audit externe payant complet sera déclenché
        automatiquement à l'un des seuils suivants :
      </p>
      <ul class="prose-list">
        <li>200 commandes cumulées sur l'année (au-delà du palier critique de risque).</li>
        <li>Incident de sécurité avéré, quel qu'il soit.</li>
        <li>Évolution vers des données plus sensibles (santé, identité).</li>
        <li>Médiatisation publique du projet.</li>
        <li>Changement de juridiction ou de régime juridique.</li>
      </ul>

      <h3 class="prose-h3">Objectifs publics</h3>
      <ul class="prose-list">
        <li><strong>SSL Labs A+</strong> — vérifié à <a href="https://www.ssllabs.com/ssltest/analyze.html?d=alartic.fr" rel="noopener">ssllabs.com</a> après MEP</li>
        <li><strong>Mozilla Observatory ≥ A</strong> — vérifié à <a href="https://observatory.mozilla.org/analyze/alartic.fr" rel="noopener">observatory.mozilla.org</a></li>
        <li><strong>Blacklight scan = 0 tracker</strong> — vérifié à <a href="https://themarkup.org/blacklight" rel="noopener">themarkup.org/blacklight</a></li>
        <li><strong>Lighthouse a11y ≥ 95 / perf ≥ 90</strong> — vérifiable depuis DevTools</li>
      </ul>
    </Container>
  </section>

  <!-- Hall of Fame -->
  <section class="section">
    <Container size="md">
      <h2 class="section__title section__title--sm">Hall of Fame.</h2>
      <p class="prose">
        Personnes ayant signalé responsablement une vulnérabilité — avec leur accord.
      </p>
      <p class="hof-empty">Aucune vulnérabilité critique signalée à ce jour.</p>
    </Container>
  </section>

  <section class="section">
    <Container size="xl">
      <CtaBanner
        variant="sky"
        eyebrow="Trouvé quelque chose ?"
        title="Écrivez-nous en privé."
        description="Engagement de réponse sous 72 h ouvrées. Safe harbor garanti."
        primaryLabel="security@alartic.fr"
        primaryHref="mailto:security@alartic.fr"
        secondaryLabel="Lire le manifeste"
        secondaryHref="/manifeste"
      />
    </Container>
  </section>

  <Footer slot="footer" />
</Base>

<script>
  import "../scripts/animations";
</script>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-7);
    background-color: var(--color-bg);
  }
  .hero__title {
    font-size: var(--fs-4xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
    margin: var(--space-4) 0 var(--space-4);
    max-width: 24ch;
  }
  .hero__lead {
    font-size: var(--fs-lg);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    max-width: 60ch;
  }

  .section {
    padding-block: var(--space-9);
  }
  .section--surface {
    background-color: var(--color-bg-accent);
  }

  .section__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
    margin-bottom: var(--space-6);
  }
  .section__title {
    font-size: var(--fs-3xl);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .section__title--sm {
    font-size: var(--fs-2xl);
    margin-bottom: var(--space-4);
  }
  .section__lead {
    font-size: var(--fs-md);
    color: var(--color-text-secondary);
    max-width: 60ch;
    margin: 0;
  }

  .prose {
    font-size: var(--fs-md);
    color: var(--color-text);
    line-height: var(--lh-relaxed);
    max-width: 65ch;
    margin-bottom: var(--space-4);
  }
  .prose-h3 {
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    margin: var(--space-5) 0 var(--space-3);
  }
  .prose-list {
    list-style: disc;
    padding-left: var(--space-5);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
  }
  .prose-list li {
    margin-bottom: var(--space-2);
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.95em;
    background-color: var(--color-bg-subtle);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }

  /* VDP card */
  .vdp-card {
    margin-top: var(--space-3);
  }
  .vdp-card__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
  .vdp-card__row:last-child {
    border-bottom: none;
  }
  .vdp-card__label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
    letter-spacing: var(--tracking-wide);
  }
  .vdp-card__value {
    font-size: var(--fs-sm);
    color: var(--color-text);
    text-align: right;
  }

  /* PGP card */
  .pgp-card {
    margin-top: var(--space-3);
  }
  .pgp-meta {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .pgp-meta {
      grid-template-columns: max-content 1fr;
      gap: var(--space-3) var(--space-5);
    }
  }
  .pgp-meta > div {
    display: contents;
  }
  .pgp-meta dt {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
    letter-spacing: var(--tracking-wide);
  }
  .pgp-meta dd {
    font-size: var(--fs-sm);
    color: var(--color-text);
    margin: 0;
  }

  .hof-empty {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
