---
import Base from "../layouts/Base.astro";
import Container from "../components/atoms/Container.astro";
import Button from "../components/atoms/Button.astro";
import Badge from "../components/atoms/Badge.astro";
import Card from "../components/atoms/Card.astro";
import Header from "../components/molecules/Header.astro";
import Footer from "../components/molecules/Footer.astro";
---

<Base title="Design system" description="Référence visuelle ALARTIC — tokens, composants, états." noindex>
  <Header slot="header" />

  <section class="section">
    <Container size="lg">
      <header class="header-block">
        <Badge variant="neutral" size="sm">Référence interne</Badge>
        <h1>Design system ALARTIC</h1>
        <p class="lead">Palette, typo, composants — source unique. Tout est variable via <code>tokens.css</code>.</p>
      </header>

      <Card variant="outlined" padding="lg" class="ds-block">
        <h2>Palette</h2>
        <div class="swatches">
          <div class="swatch" style="background: var(--color-bg)"><span>bg</span></div>
          <div class="swatch" style="background: var(--color-bg-elevated)"><span>bg-elevated</span></div>
          <div class="swatch" style="background: var(--color-bg-accent)"><span>bg-accent</span></div>
          <div class="swatch swatch--dark" style="background: var(--color-brand)"><span>brand</span></div>
          <div class="swatch swatch--dark" style="background: var(--color-accent)"><span>accent</span></div>
          <div class="swatch swatch--dark" style="background: var(--color-text)"><span>text</span></div>
        </div>
      </Card>

      <Card variant="outlined" padding="lg" class="ds-block">
        <h2>Boutons</h2>
        <div class="row">
          <Button variant="primary" size="md">Primary</Button>
          <Button variant="secondary" size="md">Secondary</Button>
          <Button variant="ghost" size="md">Ghost</Button>
          <Button variant="link" size="md">Link</Button>
        </div>
        <div class="row" style="margin-top: var(--space-4)">
          <Button variant="primary" size="sm">SM</Button>
          <Button variant="primary" size="md">MD</Button>
          <Button variant="primary" size="lg">LG</Button>
        </div>
      </Card>

      <Card variant="outlined" padding="lg" class="ds-block">
        <h2>Badges</h2>
        <div class="row">
          <Badge variant="brand">Brand</Badge>
          <Badge variant="accent">Accent</Badge>
          <Badge variant="neutral">Neutre</Badge>
          <Badge variant="success">En stock</Badge>
          <Badge variant="danger">Rupture</Badge>
        </div>
      </Card>

      <Card variant="outlined" padding="lg" class="ds-block">
        <h2>Échelle typographique</h2>
        <div class="type-stack">
          <p style="font-size: var(--fs-5xl); font-weight: var(--fw-bold); letter-spacing: var(--tracking-tight); line-height: var(--lh-tight)">5XL Display</p>
          <p style="font-size: var(--fs-4xl); font-weight: var(--fw-bold); letter-spacing: var(--tracking-tight); line-height: var(--lh-tight)">4XL Hero</p>
          <p style="font-size: var(--fs-3xl); font-weight: var(--fw-semibold)">3XL Section</p>
          <p style="font-size: var(--fs-2xl); font-weight: var(--fw-semibold)">2XL Heading</p>
          <p style="font-size: var(--fs-xl)">XL Subheading</p>
          <p style="font-size: var(--fs-lg)">LG Lead</p>
          <p style="font-size: var(--fs-md)">MD body+</p>
          <p style="font-size: var(--fs-base)">Base body</p>
          <p style="font-size: var(--fs-sm); color: var(--color-text-secondary)">SM secondaire</p>
          <p style="font-size: var(--fs-xs); color: var(--color-text-muted)">XS muted</p>
        </div>
      </Card>
    </Container>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .section {
    padding-block: var(--space-8);
  }

  .header-block {
    margin-bottom: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .lead {
    color: var(--color-text-secondary);
    font-size: var(--fs-md);
  }

  .ds-block {
    margin-bottom: var(--space-5);
  }

  .ds-block h2 {
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
    margin-bottom: var(--space-4);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--space-3);
  }

  .swatch {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: flex-end;
    padding: var(--space-3);
    font-size: var(--fs-xs);
    font-family: var(--font-mono);
    color: var(--color-text);
  }
  .swatch--dark {
    color: var(--color-text-on-brand);
    border-color: transparent;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .type-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background-color: var(--color-bg-accent);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }
</style>
