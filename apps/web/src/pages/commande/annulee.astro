---
import Base from "../../layouts/Base.astro";
import Container from "../../components/atoms/Container.astro";
import Card from "../../components/atoms/Card.astro";
import Header from "../../components/molecules/Header.astro";
import Footer from "../../components/molecules/Footer.astro";
---

<Base
  title="Paiement annulé"
  description="Le paiement a été annulé. Votre panier est conservé."
  noindex
>
  <Header slot="header" />

  <section class="cancelled">
    <Container size="md">
      <Card variant="elevated" padding="lg">
        <div class="cancelled__icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="9" y1="9" x2="15" y2="15"></line>
            <line x1="15" y1="9" x2="9" y2="15"></line>
          </svg>
        </div>

        <h1 class="cancelled__title">Paiement annulé.</h1>

        <p class="cancelled__lead">
          Aucun débit n'a été effectué. Votre panier est conservé — vous pouvez
          réessayer quand vous le souhaitez.
        </p>

        <p class="cancelled__hint">
          Si vous avez rencontré un problème avec le paiement (carte refusée,
          3DS échoué, etc.), n'hésitez pas à nous contacter.
        </p>

        <div class="cancelled__actions">
          <a href="/panier" class="cancelled__cta">Retour au panier</a>
          <a href="/contact" class="cancelled__cta-secondary">Nous contacter</a>
        </div>
      </Card>
    </Container>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .cancelled {
    padding-block: var(--space-7) var(--space-9);
    background-color: var(--color-bg-accent);
    min-height: 60vh;
  }
  .cancelled__icon {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }
  .cancelled__title {
    font-size: var(--fs-3xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-4);
  }
  .cancelled__lead {
    font-size: var(--fs-md);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    margin: 0 0 var(--space-4);
  }
  .cancelled__hint {
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
    margin: 0 0 var(--space-6);
  }
  .cancelled__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .cancelled__cta {
    display: inline-block;
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-text);
    color: var(--color-text-on-inverse);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: var(--fw-semibold);
  }
  .cancelled__cta-secondary {
    display: inline-block;
    padding: var(--space-3) var(--space-5);
    color: var(--color-text);
    text-decoration: underline;
    font-weight: var(--fw-medium);
  }
</style>
