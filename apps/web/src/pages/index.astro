---
import Base from "../layouts/Base.astro";
import Container from "../components/atoms/Container.astro";
import Button from "../components/atoms/Button.astro";
import Badge from "../components/atoms/Badge.astro";
import Header from "../components/molecules/Header.astro";
import Footer from "../components/molecules/Footer.astro";
import ProductCardLarge from "../components/molecules/ProductCardLarge.astro";
import TrustPillars from "../components/molecules/TrustPillars.astro";
import Stats from "../components/molecules/Stats.astro";
import PackAlartic from "../components/molecules/PackAlartic.astro";
import HowItWorks from "../components/molecules/HowItWorks.astro";
import ManifestoQuote from "../components/molecules/ManifestoQuote.astro";
import FaqList from "../components/molecules/FaqList.astro";
import CtaBanner from "../components/molecules/CtaBanner.astro";

const featured = [
  {
    slug: "pixel-10-pro-xl",
    name: "Pixel 10 Pro XL",
    tagline: "Le fleuron grand format. 6,8\" lumineux, batterie longue durée.",
    priceFrom: 1299,
    image: "/products/pixel-10-pro-xl-obsidian-rear.svg",
    imageAlt: "Pixel 10 Pro XL Noir Volcanique",
    isNew: true,
    variantColors: ["#0a0a0a"],
  },
  {
    slug: "pixel-10-pro",
    name: "Pixel 10 Pro",
    tagline: "Tensor G5. Zoom 5×. Tout sous votre contrôle.",
    priceFrom: 1099,
    image: "/products/pixel-10-pro-obsidian-rear.svg",
    imageAlt: "Pixel 10 Pro Noir Volcanique",
    isNew: true,
    variantColors: ["#0a0a0a"],
  },
  {
    slug: "pixel-10",
    name: "Pixel 10",
    tagline: "La nouvelle génération. Privacy native.",
    priceFrom: 899,
    image: "/products/pixel-10-indigo-rear.svg",
    imageAlt: "Pixel 10 Indigo",
    isNew: true,
    variantColors: ["#3a4a78", "#f0e8e2", "#0a0a0a"],
  },
  {
    slug: "pixel-9-pro-xl",
    name: "Pixel 9 Pro XL",
    tagline: "Le grand écran sans compromis.",
    priceFrom: 1299,
    image: "/products/pixel-9-pro-xl-obsidian-rear.svg",
    imageAlt: "Pixel 9 Pro XL Noir Volcanique",
    variantColors: ["#e8e1d2", "#a8b8a0", "#0a0a0a"],
  },
];

const stats = [
  { value: "0", label: "Tracker, pixel publicitaire, script tiers sur ce site." },
  { value: "5", suffix: "+", label: "Années de mises à jour de sécurité garanties par GrapheneOS." },
  { value: "100", suffix: "%", label: "Hébergement Suisse, juridiction européenne." },
  { value: "24", suffix: "h", label: "Délai de prise en charge SAV humain, sans chatbot." },
];

const pillars = [
  {
    icon: "shield" as const,
    title: "Sécurité matérielle",
    description: "GrapheneOS sur Pixel : sandboxing applicatif strict, vérification du démarrage matériel, mises à jour 5+ ans.",
    color: "brand" as const,
  },
  {
    icon: "eye-off" as const,
    title: "Zéro tracker",
    description: "Aucun pixel publicitaire, aucun script tiers, aucune analyse comportementale. Plausible auto-hébergé, IP anonymisée.",
    color: "ink" as const,
  },
  {
    icon: "lock" as const,
    title: "Souveraineté technique",
    description: "Hébergement Suisse, juridiction européenne. Chiffrement au repos et en transit. Vous gardez vos données.",
    color: "accent" as const,
  },
];

const packItems = [
  {
    icon: "phone" as const,
    title: "Pixel sous GrapheneOS",
    description: "Système durci, installé et configuré avec la dernière version stable.",
  },
  {
    icon: "shield" as const,
    title: "Verre anti-espion",
    description: "Filtre de confidentialité, lisible uniquement de face, posé pré-livraison.",
  },
  {
    icon: "package" as const,
    title: "Coque de protection",
    description: "Coque mat anti-traces, neutre, sans logo apparent.",
  },
  {
    icon: "battery" as const,
    title: "Chargeur USB-C 30 W",
    description: "Inclus pour les modèles Pro et XL. Câble USB-C dans tous les packs.",
  },
  {
    icon: "seal" as const,
    title: "Scellé d'inviolabilité",
    description: "Numéroté, posé devant caméra. Remplacement immédiat si rompu à réception.",
  },
  {
    icon: "certificate" as const,
    title: "Certificat signé",
    description: "Configuration, version GrapheneOS, empreinte matérielle. Format PDF signé.",
  },
  {
    icon: "video" as const,
    title: "Onboarding visioconférence",
    description: "45 minutes en tête-à-tête. 60 min pour les pliables avec multitâche.",
  },
  {
    icon: "headphones" as const,
    title: "SAV humain à vie",
    description: "Tickets chiffrés, réponse sous 24h ouvrées, sans chatbot ni script générique.",
  },
];

const steps = [
  {
    number: "01",
    title: "Vous choisissez",
    description: "Modèle, stockage, couleur. Devis pro automatique au-delà de 5 unités.",
  },
  {
    number: "02",
    title: "Nous préparons",
    description: "Installation GrapheneOS, durcissement, certificat signé, scellé numéroté.",
  },
  {
    number: "03",
    title: "Expédition tracée",
    description: "Colis discret, transporteur signé. Vous suivez chaque étape en temps réel.",
  },
  {
    number: "04",
    title: "Onboarding",
    description: "Visioconférence chiffrée 45-60 min pour la prise en main complète.",
  },
];

const faqItems = [
  {
    question: "Mes applications bancaires fonctionneront-elles ?",
    answer: "La majorité (Crédit Mutuel, BoursoBank, Revolut, etc.) fonctionnent nativement. Quelques applications (certaines néobanques) demandent un profil utilisateur séparé sous GrapheneOS. On en parle ensemble pendant l'onboarding pour valider ton cas avant achat si besoin.",
  },
  {
    question: "Pourquoi du Pixel et pas un autre constructeur ?",
    answer: "GrapheneOS ne supporte que Pixel pour des raisons techniques : Titan M2 (sécurité matérielle), bootloader déverrouillable de manière auditée, mises à jour 5-7 ans. Aucun autre constructeur ne combine ces trois éléments aujourd'hui.",
  },
  {
    question: "Que se passe-t-il si je casse mon téléphone ?",
    answer: "Garantie matérielle Google 24 mois (article L217-3) + garantie ALARTIC 12 mois sur la prestation logicielle. SAV en tickets chiffrés, diagnostic gratuit. Aucune intervention payante sans validation explicite de ta part.",
  },
  {
    question: "Vous gardez mes données après achat ?",
    answer: "Le strict minimum légal : facture (10 ans, obligation comptable), adresse de livraison (chiffrée AES-256-GCM). Comptes inactifs supprimés automatiquement après 3 ans. Tu peux exporter ou supprimer ton compte à tout moment.",
  },
];
---

<Base title="ALARTIC" description="Smartphones Pixel durcis sous GrapheneOS. Privacy radicale, souveraineté technique, SAV humain. Hébergé en Suisse.">
  <Header slot="header" />

  <!-- ─────────── HERO ─────────── -->
  <section class="hero">
    <Container size="xl">
      <div class="hero__grid">
        <div class="hero__copy" data-anim="hero-stagger">
          <Badge variant="brand" size="md">Hébergé en Suisse — Zéro tracker</Badge>
          <h1 class="hero__title">
            Votre téléphone.<br />
            <span class="hero__title-accent">Vraiment à vous.</span>
          </h1>
          <p class="hero__lead">
            Pixel durcis sous <strong>GrapheneOS</strong>. Configurés, scellés et expédiés depuis l'Europe.
            Aucun cloud Google, aucun tracker, aucune dépendance.
          </p>
          <div class="hero__cta">
            <Button href="/modeles" variant="primary" size="lg">Découvrir les modèles</Button>
            <Button href="/manifeste" variant="link" size="lg">Lire le manifeste</Button>
          </div>
          <div class="hero__signals">
            <span><strong>SSL Labs A+</strong></span>
            <span class="hero__sep" aria-hidden="true">·</span>
            <span><strong>0 cookie</strong> tiers</span>
            <span class="hero__sep" aria-hidden="true">·</span>
            <span><strong>RGPD</strong> par construction</span>
          </div>
        </div>
        <div class="hero__media" aria-hidden="true">
          <div class="hero__device-stack" data-anim="hero-devices">
            <img
              src="/products/pixel-10-pro-obsidian-rear.svg"
              alt=""
              class="hero__device hero__device--rear"
              loading="eager"
              decoding="async"
            />
            <img
              src="/products/pixel-10-pro-obsidian-front.svg"
              alt=""
              class="hero__device hero__device--front"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ─────────── STATS ─────────── -->
  <section class="section section--tight">
    <Container size="xl">
      <Stats stats={stats} />
    </Container>
  </section>

  <!-- ─────────── TRUST PILLARS ─────────── -->
  <section class="section section--surface">
    <Container size="lg">
      <header class="section__header">
        <p class="eyebrow">Nos engagements</p>
        <h2 class="section__title">Trois principes non négociables.</h2>
        <p class="section__lead">
          Pas un slogan. Une architecture technique vérifiable, page après page.
        </p>
      </header>
      <TrustPillars pillars={pillars} />
    </Container>
  </section>

  <!-- ─────────── PRODUITS ─────────── -->
  <section class="section">
    <Container size="xl">
      <div data-anim="reveal">
        <header class="section__header section__header--with-cta">
          <div>
            <p class="eyebrow">La gamme</p>
            <h2 class="section__title">Explorez les Pixel.</h2>
            <p class="section__lead">Tous les modèles actuels, durcis et configurés pour vous.</p>
          </div>
          <Button href="/modeles" variant="link" size="md">Comparer tous les modèles</Button>
        </header>
        <div class="product-grid">
          {featured.map((p) => <ProductCardLarge {...p} />)}
        </div>
      </div>
    </Container>
  </section>

  <!-- ─────────── PACK ALARTIC ─────────── -->
  <section class="section section--surface">
    <Container size="lg">
      <header class="section__header">
        <p class="eyebrow">Inclus dans chaque envoi</p>
        <h2 class="section__title">Le Pack ALARTIC.</h2>
        <p class="section__lead">
          Tout ce dont vous avez besoin pour démarrer. Aucun supplément caché.
        </p>
      </header>
      <PackAlartic items={packItems} />
    </Container>
  </section>

  <!-- ─────────── HOW IT WORKS ─────────── -->
  <section class="section">
    <Container size="lg">
      <header class="section__header">
        <p class="eyebrow">Le parcours</p>
        <h2 class="section__title">De la commande à votre main.</h2>
        <p class="section__lead">
          Une démarche transparente, traçable, et humaine de bout en bout.
        </p>
      </header>
      <HowItWorks steps={steps} />
    </Container>
  </section>

  <!-- ─────────── MANIFESTO QUOTE ─────────── -->
  <section class="section section--inverse">
    <Container size="md">
      <ManifestoQuote
        quote="Un téléphone n'est pas un service. C'est un objet personnel qui vous appartient, qui contient votre vie, et qui ne doit rien à personne."
        attribution="Manifeste ALARTIC"
        href="/manifeste"
      />
    </Container>
  </section>

  <!-- ─────────── FAQ ─────────── -->
  <section class="section section--surface">
    <Container size="md">
      <header class="section__header">
        <p class="eyebrow">Questions fréquentes</p>
        <h2 class="section__title">Les choses qu'on nous demande souvent.</h2>
      </header>
      <FaqList items={faqItems} />
      <div class="section__footer">
        <Button href="/faq" variant="link" size="md">Voir la FAQ complète</Button>
      </div>
    </Container>
  </section>

  <!-- ─────────── CTA FINAL ─────────── -->
  <section class="section">
    <Container size="xl">
      <CtaBanner
        variant="sky"
        eyebrow="Prêt à reprendre la main ?"
        title="Commencez par lire notre manifeste."
        description="Avant d'acheter, lisez. Si nos principes ne vous parlent pas, ne nous achetez rien."
        primaryLabel="Lire le manifeste"
        primaryHref="/manifeste"
        secondaryLabel="Demander un devis pro"
        secondaryHref="/devis-pro"
      />
    </Container>
  </section>

  <Footer slot="footer" />
</Base>

<script>
  import "../scripts/animations";
</script>

<style>
  /* ───────── Hero ───────── */
  .hero {
    padding-block: var(--space-9) var(--space-8);
    background-color: var(--color-bg);
    overflow: hidden;
    position: relative;
  }
  .hero::before {
    content: "";
    position: absolute;
    top: -20%;
    right: -10%;
    width: 60%;
    height: 90%;
    background: radial-gradient(
      ellipse at center,
      var(--color-bg-accent) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }
  .hero > * {
    position: relative;
    z-index: 1;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "copy"
      "media";
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.2fr 1fr;
      grid-template-areas: "copy media";
      gap: var(--space-8);
    }
  }

  .hero__copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .hero__title {
    font-size: var(--fs-5xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
    text-wrap: balance;
    margin: 0;
  }

  .hero__title-accent {
    color: var(--color-brand);
  }

  .hero__lead {
    font-size: var(--fs-lg);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    max-width: 48ch;
  }

  .hero__cta {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .hero__signals {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    margin-top: var(--space-4);
  }

  .hero__signals strong {
    color: var(--color-text);
    font-weight: var(--fw-medium);
  }

  .hero__sep {
    color: var(--color-border-strong);
  }

  .hero__media {
    grid-area: media;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-5);
  }

  .hero__device-stack {
    width: 100%;
    max-width: 220px;
    aspect-ratio: 1 / 1;
    /* Grille avec tous les enfants centrés et empilés sur grid-area 1/1
     * → superposition parfaite peu importe les largeurs SVG intrinsèques. */
    display: grid;
    place-items: center;
  }

  @media (min-width: 900px) {
    .hero__device-stack {
      max-width: 290px;
    }
  }

  .hero__device {
    grid-area: 1 / 1;
    max-height: 92%;
    width: auto;
  }

  .hero__device--rear {
    /* Position finale relative au centre — GSAP override en inline pour
     * l'animation. Fallback no-JS : phones décalés correctement. */
    transform: translateX(-28%) rotate(-10deg);
    z-index: 1;
    opacity: 0.88;
  }

  .hero__device--front {
    transform: translateX(28%) rotate(6deg);
    z-index: 2;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.18));
  }

  /* Hover effect retiré : GSAP gère maintenant les transforms inline,
   * le CSS hover ne prenait plus le dessus proprement. À réintroduire en
   * GSAP plus tard si besoin (event listeners + tween hover). */

  /* ───────── Sections génériques ───────── */
  .section {
    padding-block: var(--space-9);
  }

  .section--tight {
    padding-block: var(--space-7);
  }

  .section--surface {
    background-color: var(--color-bg-accent);
  }

  .section--inverse {
    background-color: var(--color-bg);
    padding-block: var(--space-10);
  }

  .section__header {
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .section__header--with-cta {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .section__title {
    font-size: var(--fs-3xl);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .section__lead {
    color: var(--color-text-secondary);
    font-size: var(--fs-md);
    max-width: 56ch;
    margin: 0;
  }

  .section__footer {
    margin-top: var(--space-6);
    display: flex;
    justify-content: center;
  }

  .eyebrow {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-brand);
    margin: 0;
  }

  /* ───────── Product grid ───────── */
  .product-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
