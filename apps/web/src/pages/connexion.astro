---
import Base from "../layouts/Base.astro";
import Container from "../components/atoms/Container.astro";
import Badge from "../components/atoms/Badge.astro";
import Card from "../components/atoms/Card.astro";
import Header from "../components/molecules/Header.astro";
import Footer from "../components/molecules/Footer.astro";

// En dev, le front Astro tourne sur :4321 et l'API Axum sur :3000.
// En prod, Caddy reverse-proxie /api/* vers le binaire → URL relative suffit.
const API_BASE = import.meta.env.DEV ? "http://localhost:3000" : "/api";
---

<Base
  title="Connexion"
  description="Connectez-vous à votre espace client ALARTIC via un magic link."
  noindex
>
  <Header slot="header" />

  <section class="auth">
    <Container size="sm">
      <Card variant="elevated" padding="lg">
        <header class="auth__header">
          <Badge variant="brand" size="sm">Espace client</Badge>
          <h1 class="auth__title">Connexion.</h1>
          <p class="auth__lead">
            Pas de mot de passe. Vous recevez un lien temporaire par email
            (<strong>15 minutes</strong>, usage unique).
          </p>
        </header>

        <div id="auth-form-wrap">
          <form id="magic-link-form" class="auth__form" novalidate>
            <div class="auth__row">
              <label for="email" class="auth__label">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                class="auth__input"
                required
                autocomplete="email"
                placeholder="vous@exemple.fr"
                autofocus
              />
            </div>
            <button type="submit" class="auth__submit" id="magic-link-submit">
              Recevoir le lien
            </button>
            <p id="magic-link-msg" class="auth__msg" hidden></p>
          </form>
        </div>

        <div class="auth__divider"><span>ou</span></div>

        <p class="auth__alt">
          Pas encore de compte ? <a href="/inscription">Créer un compte</a>.
        </p>
      </Card>

      <p class="auth__reassurance">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        Votre email est chiffré au repos (AES-256-GCM). Aucune trace de tracking.
      </p>
    </Container>
  </section>

  <Footer slot="footer" />
</Base>

<script define:vars={{ API_BASE }}>
  // Pattern Astro ClientRouter : re-bind à chaque navigation via AbortController.
  let abortCtl;
  let pollTimer;

  function isLoggedIn() {
    // Le cookie csrf (non-HttpOnly) sert de proxy : présent = session active.
    return document.cookie.split("; ").some((c) => c.startsWith("alartic_csrf="));
  }

  function setupConnexion() {
    abortCtl?.abort();
    abortCtl = new AbortController();
    const signal = abortCtl.signal;
    clearInterval(pollTimer);

    // Si l'utilisateur est déjà connecté (ex. autre onglet a fait le consume),
    // on saute directement /compte.
    if (isLoggedIn()) {
      window.location.replace("/compte");
      return;
    }

    const form = document.getElementById("magic-link-form");
    const btn = document.getElementById("magic-link-submit");
    const msg = document.getElementById("magic-link-msg");
    const wrap = document.getElementById("auth-form-wrap");
    if (!form || !btn || !msg || !wrap) return;

    form.addEventListener(
      "submit",
      async (e) => {
        e.preventDefault();
        const email = form.email.value.trim();
        if (!email) return;

        btn.disabled = true;
        btn.textContent = "Envoi…";
        msg.hidden = true;
        msg.classList.remove("auth__msg--error");

        try {
          const res = await fetch(`${API_BASE}/auth/magic-link/request`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "include",
            body: JSON.stringify({ email, purpose: "login" }),
          });
          if (res.ok) {
            renderSuccess(email);
          } else if (res.status === 400) {
            showError("Format d'email invalide.");
          } else {
            showError("Une erreur est survenue. Réessayez dans un instant.");
          }
        } catch (err) {
          showError("Impossible de joindre le serveur. Vérifiez votre connexion.");
        }
      },
      { signal }
    );

    function renderSuccess(email) {
      const safe = escapeHtml(email);
      wrap.innerHTML = `
        <div class="auth__success">
          <h2 class="auth__success-title">Vérifiez votre boîte mail.</h2>
          <p class="auth__success-lead">
            Un lien de connexion a été envoyé à <strong>${safe}</strong>.
            Cliquez dessus dans les <strong>15 minutes</strong> pour vous connecter.
          </p>
          <p class="auth__hint">
            Cet onglet vous redirigera automatiquement vers votre espace dès
            que vous aurez cliqué sur le lien (pensez à vérifier vos spams).
          </p>
        </div>
      `;
      // Poll de la session : dès que le cookie csrf apparaît (l'autre onglet
      // a fait le consume), on bascule sur /compte.
      pollTimer = setInterval(() => {
        if (isLoggedIn()) {
          clearInterval(pollTimer);
          window.location.replace("/compte");
        }
      }, 1500);
    }

    function showError(text) {
      msg.hidden = false;
      msg.textContent = text;
      msg.classList.add("auth__msg--error");
      btn.disabled = false;
      btn.textContent = "Recevoir le lien";
    }

    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, (c) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[c]);
    }
  }

  document.addEventListener("astro:page-load", setupConnexion);
  document.addEventListener("astro:before-swap", () => {
    abortCtl?.abort();
    clearInterval(pollTimer);
  });
</script>

<style>
  .auth {
    padding-block: var(--space-9);
    background-color: var(--color-bg-accent);
    min-height: 60vh;
  }

  .auth__header {
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .auth__title {
    font-size: var(--fs-3xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .auth__lead {
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    margin: 0;
  }
  .auth__lead strong {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
  }

  .auth__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .auth__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .auth__label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .auth__input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: var(--fs-base);
    color: var(--color-text);
    background-color: var(--color-bg);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .auth__input:focus {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
    border-color: var(--color-brand);
  }

  .auth__submit {
    padding: var(--space-4) var(--space-5);
    background-color: var(--color-text);
    color: var(--color-text-on-inverse);
    border: 1px solid var(--color-text);
    border-radius: var(--radius-full);
    font-family: inherit;
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    cursor: pointer;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .auth__submit:hover:not(:disabled) {
    opacity: 0.85;
  }
  .auth__submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .auth__msg {
    margin: 0;
    font-size: var(--fs-sm);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-accent);
    border: 1px solid var(--color-border);
  }
  .auth__msg--error {
    color: var(--color-danger, #b91c1c);
    background-color: #fef2f2;
    border-color: #fecaca;
  }

  .auth__success {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-accent);
    border: 1px solid var(--color-border);
  }
  .auth__success-title {
    margin: 0;
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
  }
  .auth__success-lead {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
  }
  .auth__hint {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }

  .auth__divider {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-5) 0;
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }
  .auth__divider::before,
  .auth__divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background-color: var(--color-border);
  }

  .auth__alt {
    text-align: center;
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
    margin: 0;
  }
  .auth__alt a {
    color: var(--color-brand);
    font-weight: var(--fw-medium);
    text-decoration: underline;
  }

  .auth__reassurance {
    margin-top: var(--space-5);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
