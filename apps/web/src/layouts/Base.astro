---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = "ALARTIC — Smartphones Pixel durcis sous GrapheneOS. Privacy radicale, souveraineté technique, SAV humain.",
  noindex = false,
} = Astro.props;

const fullTitle = title === "ALARTIC" ? title : `${title} — ALARTIC`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7f4" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/logo.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo.png" />
    <meta property="og:locale" content="fr_FR" />

    <title>{fullTitle}</title>

    <!-- Transitions client-side natives (View Transitions API + fallback).
         Les <script> avec import du module animations.ts seront ré-exécutés
         à chaque navigation, ce qui ré-init GSAP proprement. -->
    <ClientRouter />
  </head>

  <body>
    <a href="#main" class="skip-link">Aller au contenu principal</a>

    <slot name="header" />

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />

    <!-- ─────────── Toast "Ajouté au panier" ─────────── -->
    <div
      class="cart-toast"
      data-cart-toast
      role="status"
      aria-live="polite"
      aria-atomic="true"
      hidden
    >
      <div class="cart-toast__header">
        <span class="cart-toast__title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Ajouté au panier
        </span>
        <button type="button" class="cart-toast__close" data-cart-toast-close aria-label="Fermer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="cart-toast__body">
        <div class="cart-toast__media" data-cart-toast-media></div>
        <div class="cart-toast__info">
          <p class="cart-toast__name" data-cart-toast-name></p>
          <p class="cart-toast__meta" data-cart-toast-meta></p>
          <div class="cart-toast__tags" data-cart-toast-tags></div>
          <p class="cart-toast__price" data-cart-toast-price></p>
        </div>
      </div>

      <a href="/panier" class="cart-toast__btn">Accéder au panier</a>
    </div>

    <script>
      import { cart, type CartItem } from "../scripts/cart";

      const fmt = new Intl.NumberFormat("fr-FR", {
        style: "currency",
        currency: "EUR",
        maximumFractionDigits: 0,
      });

      function escape(s: string): string {
        return s.replace(/[&<>"']/g, (c) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!
        );
      }

      function modsTags(mods: CartItem["mods"]): string[] {
        const tags: string[] = [];
        if (mods.mic) tags.push("Micro supprimé");
        if (mods.frontCam) tags.push("Caméra avant supprimée");
        if (mods.rearCam) tags.push("Caméra arrière supprimée");
        return tags;
      }

      let hideTimer: number | null = null;

      /* Aligne le toast sous l'icône panier du header. Si l'icône n'est pas
       * (encore) dans le DOM, fallback en haut-droite avec marge. */
      function positionToast(toast: HTMLElement) {
        const cartLink = document.querySelector<HTMLElement>("[data-cart-link]");
        if (!cartLink) {
          toast.style.top = "12px";
          toast.style.right = "12px";
          return;
        }
        const rect = cartLink.getBoundingClientRect();
        const gap = 12;
        toast.style.top = `${Math.round(rect.bottom + gap)}px`;
        toast.style.right = `${Math.round(window.innerWidth - rect.right)}px`;
      }

      function show(item: CartItem) {
        const toast = document.querySelector<HTMLElement>("[data-cart-toast]");
        if (!toast) return;
        const media = toast.querySelector<HTMLElement>("[data-cart-toast-media]");
        const name = toast.querySelector<HTMLElement>("[data-cart-toast-name]");
        const meta = toast.querySelector<HTMLElement>("[data-cart-toast-meta]");
        const tags = toast.querySelector<HTMLElement>("[data-cart-toast-tags]");
        const price = toast.querySelector<HTMLElement>("[data-cart-toast-price]");

        if (media) {
          media.innerHTML = item.colorImage
            ? `<img src="${escape(item.colorImage)}" alt="" />`
            : "";
        }
        if (name) name.textContent = item.productName;
        if (meta) {
          meta.textContent = `${item.colorName} · ${item.storageLabel}`;
        }
        if (tags) {
          const t = modsTags(item.mods);
          tags.innerHTML = t.map((x) => `<span class="cart-toast__tag">${escape(x)}</span>`).join("");
        }
        if (price) price.textContent = fmt.format(item.unitPrice * item.qty);

        positionToast(toast);
        toast.hidden = false;
        /* Double rAF garantit qu'on est dans une frame séparée du
         * passage hidden=false, sinon la transition opacity 0→1 peut être
         * sautée par le navigateur (élément invisible la frame d'avant). */
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            toast.dataset.open = "true";
          });
        });

        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = window.setTimeout(hide, 2500);
      }

      function hide() {
        const toast = document.querySelector<HTMLElement>("[data-cart-toast]");
        if (!toast) return;
        delete toast.dataset.open;
        /* attendre la fin du fondu avant de hidden=true (cf. transition CSS) */
        window.setTimeout(() => {
          if (!toast.dataset.open) toast.hidden = true;
        }, 820);
      }

      /* Repositionner pendant l'affichage si la fenêtre est redimensionnée ou
       * si l'utilisateur scroll (header sticky → le panier reste, mais la
       * position absolue calculée doit suivre). */
      window.addEventListener("resize", () => {
        const t = document.querySelector<HTMLElement>("[data-cart-toast]");
        if (t && t.dataset.open) positionToast(t);
      });
      window.addEventListener(
        "scroll",
        () => {
          const t = document.querySelector<HTMLElement>("[data-cart-toast]");
          if (t && t.dataset.open) positionToast(t);
        },
        { passive: true },
      );

      cart.onAdd(show);

      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest("[data-cart-toast-close]")) hide();
      });
    </script>
  </body>
</html>

<style is:global>
  .cart-toast {
    position: fixed;
    /* top/right calculés dynamiquement par positionToast() pour s'aligner
     * sous l'icône panier du header. Fallback CSS si JS pas encore exécuté. */
    top: 12px;
    right: 12px;
    z-index: var(--z-toast, 1000);
    width: min(360px, calc(100vw - 24px));
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    opacity: 0;
    transition: opacity 800ms var(--ease-out);
  }
  .cart-toast[data-open="true"] {
    opacity: 1;
  }
  .cart-toast[hidden] {
    display: none;
  }

  .cart-toast__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .cart-toast__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-success);
  }
  .cart-toast__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .cart-toast__close:hover {
    background-color: var(--color-bg-subtle);
    color: var(--color-text);
  }

  .cart-toast__body {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
  }
  .cart-toast__media {
    width: 64px;
    height: 64px;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-1);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .cart-toast__media img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .cart-toast__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .cart-toast__name {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    margin: 0;
    line-height: var(--lh-snug);
  }
  .cart-toast__meta {
    font-size: var(--fs-xs);
    color: var(--color-text-secondary);
    margin: 0;
  }
  .cart-toast__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: var(--space-1);
  }
  .cart-toast__tags:empty {
    display: none;
  }
  .cart-toast__tag {
    display: inline-flex;
    padding: 1px 6px;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-sm);
    font-size: 10px;
    color: var(--color-text-secondary);
    font-weight: var(--fw-medium);
  }
  .cart-toast__price {
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    color: var(--color-text);
    margin: var(--space-1) 0 0;
  }

  .cart-toast__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-text);
    color: var(--color-text-on-inverse);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .cart-toast__btn:hover {
    opacity: 0.85;
    color: var(--color-text-on-inverse);
  }
</style>
