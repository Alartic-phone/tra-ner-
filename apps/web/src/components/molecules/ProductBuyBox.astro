---
/**
 * ProductBuyBox — sélecteurs couleur × stockage × quantité + prix dynamique + CTA.
 *
 * Comportement :
 * - Au changement de couleur : met à jour l'image principale (event delegation
 *   géré dans la page fiche via l'attribut data-color-target).
 * - Au changement de stockage : met à jour le prix affiché.
 * - Au changement de quantité : multiplie le prix par la quantité.
 * - Si quantité ≥ 5 : bascule "Commander" → "Demander un devis pro"
 *   (CDC §7.3).
 *
 * Pas de framework. Vanilla JS bundlé par Astro, conforme CSP 'self'.
 */

interface Color {
  slug: string;
  name: string;
  hex: string;
  frontImage: string;
  rearImage?: string;
}

interface Storage {
  slug: string;
  label: string;
  price: number;
  payplugUrl?: string;
}

interface Props {
  productSlug: string;
  productName: string;
  colors: Color[];
  storages: Storage[];
  stock?: number;
  available: boolean;
}

const {
  productSlug,
  productName,
  colors,
  storages,
  stock,
  available,
} = Astro.props;

const fmtPrice = (n: number) =>
  new Intl.NumberFormat("fr-FR", {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 0,
  }).format(n);

const minPrice = Math.min(...storages.map((s) => s.price));

let stockLabel = "En stock";
let stockVariant: "success" | "warning" | "danger" = "success";
if (!available) {
  stockLabel = "Indisponible";
  stockVariant = "danger";
} else if (stock !== undefined && stock <= 0) {
  stockLabel = "Rupture temporaire";
  stockVariant = "danger";
} else if (stock !== undefined && stock <= 3) {
  stockLabel = `Stock limité (${stock} unités)`;
  stockVariant = "warning";
}
---

<div class="buybox" data-buybox data-product-slug={productSlug} data-product-name={productName}>
  <div class="buybox__stock">
    <span class:list={["stock-badge", `stock-badge--${stockVariant}`]}>
      <span class="stock-badge__dot" aria-hidden="true"></span>
      {stockLabel}
    </span>
  </div>

  <fieldset class="buybox__field" data-buybox-color>
    <legend class="buybox__legend">
      Couleur <span class="buybox__legend-value" data-color-display>{colors[0].name}</span>
    </legend>
    <div class="color-swatches" role="radiogroup" aria-label="Choisir la couleur">
      {colors.map((c, i) => (
        <label
          class="color-swatches__item"
          data-color-slug={c.slug}
          data-color-name={c.name}
          data-color-image={c.rearImage ?? c.frontImage}
        >
          <input
            type="radio"
            name="color"
            value={c.slug}
            checked={i === 0}
            class="sr-only"
          />
          <span
            class="color-swatches__dot"
            style={`background-color: ${c.hex}`}
            aria-hidden="true"
          ></span>
          <span class="sr-only">{c.name}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <fieldset class="buybox__field" data-buybox-storage>
    <legend class="buybox__legend">Stockage</legend>
    <div class="storage-options" role="radiogroup" aria-label="Choisir le stockage">
      {storages.map((s, i) => (
        <label class="storage-option" data-storage-slug={s.slug} data-storage-label={s.label} data-price={s.price}>
          <input
            type="radio"
            name="storage"
            value={s.slug}
            checked={i === 0}
            class="sr-only"
          />
          <span class="storage-option__label">{s.label}</span>
          <span class="storage-option__price">{fmtPrice(s.price)}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <fieldset class="buybox__field buybox__field--inline" data-buybox-qty>
    <legend class="buybox__legend">Quantité</legend>
    <div class="qty-stepper">
      <button
        type="button"
        class="qty-stepper__btn"
        data-qty-decrement
        aria-label="Réduire la quantité"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
      <input
        type="number"
        class="qty-stepper__input"
        data-qty-input
        value="1"
        min="1"
        max="99"
        aria-label="Quantité"
        inputmode="numeric"
      />
      <button
        type="button"
        class="qty-stepper__btn"
        data-qty-increment
        aria-label="Augmenter la quantité"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>
  </fieldset>

  <div class="buybox__total">
    <span class="buybox__total-label">Total</span>
    <span class="buybox__total-price" data-total-price>{fmtPrice(minPrice)}</span>
  </div>

  <div class="buybox__cta">
    <button
      type="button"
      class="buybox__btn buybox__btn--primary"
      data-buy-button
      disabled={!available}
    >
      <span data-buy-label>Ajouter au panier</span>
    </button>
    <p class="buybox__pro-notice" data-pro-notice hidden>
      Pour 5 unités ou plus, demandez un devis pro
      <span aria-hidden="true">→</span>
    </p>
  </div>

  <p class="buybox__legal">
    Livraison France métropolitaine 3-7 jours.
    Aucune donnée bancaire stockée — paiement via <strong>Payplug</strong> ou <strong>PayPal</strong>.
  </p>
</div>

<script>
  import { cart } from "../../scripts/cart";

  /* ───────── Wiring de tous les buyboxes — compat Astro ClientRouter ─────────
   * AbortController cleané au before-swap → tous les listeners disparaissent
   * en un appel. astro:page-load → re-bind sur le DOM courant (premier load,
   * navigation, bfcache restore).
   */
  let controller: AbortController | null = null;

  function setup(): void {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const boxes = document.querySelectorAll<HTMLElement>("[data-buybox]");
    if (boxes.length === 0) return;

    const fmt = new Intl.NumberFormat("fr-FR", {
      style: "currency",
      currency: "EUR",
      maximumFractionDigits: 0,
    });

    boxes.forEach((box) => {
      const colorInputs = box.querySelectorAll<HTMLInputElement>('input[name="color"]');
      const storageInputs = box.querySelectorAll<HTMLInputElement>('input[name="storage"]');
      const qtyInput = box.querySelector<HTMLInputElement>("[data-qty-input]");
      const qtyDec = box.querySelector<HTMLButtonElement>("[data-qty-decrement]");
      const qtyInc = box.querySelector<HTMLButtonElement>("[data-qty-increment]");
      const totalEl = box.querySelector<HTMLElement>("[data-total-price]");
      const colorDisplay = box.querySelector<HTMLElement>("[data-color-display]");
      const buyButton = box.querySelector<HTMLButtonElement>("[data-buy-button]");
      const buyLabel = box.querySelector<HTMLElement>("[data-buy-label]");
      const proNotice = box.querySelector<HTMLElement>("[data-pro-notice]");
      const productSlug = box.dataset.productSlug || "";
      const productName = box.dataset.productName || "";

      function getSelectedStoragePrice(): number {
        const selected = box.querySelector<HTMLInputElement>('input[name="storage"]:checked');
        if (!selected) return 0;
        const label = selected.closest<HTMLElement>(".storage-option");
        return Number(label?.dataset.price ?? 0);
      }

      function getQty(): number {
        const n = Number(qtyInput?.value ?? 1);
        return Math.max(1, Math.min(99, Number.isFinite(n) ? n : 1));
      }

      function getSelectedColorSlug(): string {
        const selected = box.querySelector<HTMLInputElement>('input[name="color"]:checked');
        return selected?.value ?? "";
      }

      function update() {
        const price = getSelectedStoragePrice();
        const qty = getQty();
        const total = price * qty;
        if (totalEl) totalEl.textContent = fmt.format(total);

        const isPro = qty >= 5;
        if (buyLabel) buyLabel.textContent = isPro ? "Demander un devis pro" : "Ajouter au panier";
        if (proNotice) proNotice.hidden = !isPro;

        const color = getSelectedColorSlug();
        box.dispatchEvent(
          new CustomEvent("buybox:change", {
            bubbles: true,
            detail: { productSlug, color, storagePrice: price, qty, total, isPro },
          }),
        );
      }

      function updateColorLabel() {
        const checked = box.querySelector<HTMLInputElement>('input[name="color"]:checked');
        const wrap = checked?.closest<HTMLElement>(".color-swatches__item");
        if (colorDisplay && wrap) colorDisplay.textContent = wrap.dataset.colorName ?? "";
      }

      colorInputs.forEach((i) =>
        i.addEventListener(
          "change",
          () => {
            updateColorLabel();
            update();
          },
          { signal },
        ),
      );
      storageInputs.forEach((i) => i.addEventListener("change", update, { signal }));

      qtyDec?.addEventListener(
        "click",
        () => {
          if (!qtyInput) return;
          qtyInput.value = String(Math.max(1, getQty() - 1));
          update();
        },
        { signal },
      );
      qtyInc?.addEventListener(
        "click",
        () => {
          if (!qtyInput) return;
          qtyInput.value = String(Math.min(99, getQty() + 1));
          update();
        },
        { signal },
      );
      qtyInput?.addEventListener("input", update, { signal });

      buyButton?.addEventListener(
        "click",
        () => {
          const qty = getQty();
          const color = getSelectedColorSlug();
          const colorWrap = box.querySelector<HTMLElement>('.color-swatches__item:has(input:checked)');
          const colorName = colorWrap?.dataset.colorName ?? "";
          const colorImage = colorWrap?.dataset.colorImage ?? "";
          const storageInput = box.querySelector<HTMLInputElement>('input[name="storage"]:checked');
          const storage = storageInput?.value ?? "";
          const storageLabel =
            storageInput?.closest<HTMLElement>(".storage-option")?.dataset.storageLabel ?? "";

          /* ≥ 5 unités : bascule directe vers /devis-pro, sans passer par le panier. */
          if (qty >= 5) {
            const url = `/devis-pro?product=${encodeURIComponent(productSlug)}&color=${encodeURIComponent(color)}&storage=${encodeURIComponent(storage)}&qty=${qty}`;
            window.location.href = url;
            return;
          }

          cart.add({
            productSlug,
            productName,
            colorSlug: color,
            colorName,
            colorImage,
            storageSlug: storage,
            storageLabel,
            unitPrice: getSelectedStoragePrice(),
            qty,
            mods: { mic: false, frontCam: false, rearCam: false },
          });
        },
        { signal },
      );

      /* Init */
      updateColorLabel();
      update();
    });
  }

  document.addEventListener("astro:before-swap", () => controller?.abort());
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .buybox {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  /* ───────── Stock badge ───────── */
  .buybox__stock {
    display: flex;
  }
  .stock-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wide);
  }
  .stock-badge__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: currentColor;
  }
  .stock-badge--success {
    color: var(--color-success);
    background-color: color-mix(in srgb, var(--color-success) 10%, transparent);
  }
  .stock-badge--warning {
    color: var(--color-warning);
    background-color: color-mix(in srgb, var(--color-warning) 12%, transparent);
  }
  .stock-badge--danger {
    color: var(--color-danger);
    background-color: color-mix(in srgb, var(--color-danger) 10%, transparent);
  }

  /* ───────── Fieldsets ───────── */
  .buybox__field {
    border: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .buybox__field--inline {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .buybox__legend {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
    letter-spacing: var(--tracking-wide);
    padding: 0;
  }

  .buybox__legend-value {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
  }

  .buybox__legend-hint {
    margin-left: var(--space-2);
    font-size: var(--fs-xs);
    font-weight: var(--fw-regular);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-normal);
    text-transform: none;
  }

  /* ───────── Color swatches ───────── */
  .color-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .color-swatches__item {
    position: relative;
    width: 36px;
    height: 36px;
    cursor: pointer;
    border-radius: var(--radius-full);
    border: 2px solid transparent;
    padding: 3px;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .color-swatches__item:has(input:checked) {
    border-color: var(--color-text);
  }
  .color-swatches__item:hover {
    border-color: var(--color-border-strong);
  }
  .color-swatches__item:has(input:focus-visible) {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }
  .color-swatches__dot {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }

  /* ───────── Storage options ───────── */
  .storage-options {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }
  @media (min-width: 480px) {
    .storage-options {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .storage-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    background-color: var(--color-bg-elevated);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }
  .storage-option:hover {
    border-color: var(--color-border-strong);
  }
  .storage-option:has(input:checked) {
    border-color: var(--color-text);
    background-color: var(--color-bg-subtle);
  }
  .storage-option:has(input:focus-visible) {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }
  .storage-option__label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }
  .storage-option__price {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
  }
  .storage-option:has(input:checked) .storage-option__price {
    color: var(--color-text);
  }

  /* ───────── Qty stepper ───────── */
  .qty-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background-color: var(--color-bg-elevated);
  }
  .qty-stepper__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .qty-stepper__btn:hover {
    background-color: var(--color-bg-subtle);
  }
  .qty-stepper__input {
    width: 44px;
    height: 36px;
    text-align: center;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    border: none;
    background: transparent;
    -moz-appearance: textfield;
  }
  .qty-stepper__input::-webkit-outer-spin-button,
  .qty-stepper__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* ───────── Total ───────── */
  .buybox__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .buybox__total-label {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    letter-spacing: var(--tracking-wide);
  }
  .buybox__total-price {
    font-size: var(--fs-2xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }

  /* ───────── CTA ───────── */
  .buybox__cta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .buybox__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-full);
    font-family: inherit;
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    line-height: 1;
    cursor: pointer;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .buybox__btn:active:not(:disabled) {
    transform: scale(0.98);
  }
  .buybox__btn:disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }
  .buybox__btn--primary {
    background-color: var(--color-text);
    color: var(--color-text-on-inverse);
    border: 1px solid var(--color-text);
  }
  .buybox__btn--primary:hover:not(:disabled) {
    opacity: 0.85;
  }

  .buybox__pro-notice {
    font-size: var(--fs-sm);
    color: var(--color-brand);
    text-align: center;
    margin: 0;
  }


  /* ───────── Legal ───────── */
  .buybox__legal {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--lh-relaxed);
  }
  .buybox__legal strong {
    color: var(--color-text-secondary);
    font-weight: var(--fw-medium);
  }
</style>
