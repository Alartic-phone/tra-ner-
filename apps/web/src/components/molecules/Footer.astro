---
import Container from "../atoms/Container.astro";

const columns = [
  {
    title: "Produits",
    links: [
      { label: "Tous les modèles", href: "/modeles" },
      { label: "Pixel 10 Pro XL", href: "/modeles/pixel-10-pro-xl" },
      { label: "Pixel 10 Pro", href: "/modeles/pixel-10-pro" },
      { label: "Compatibilité apps", href: "/compatibilite" },
    ],
  },
  {
    title: "Confiance",
    links: [
      { label: "Manifeste", href: "/manifeste" },
      { label: "Politique de sécurité", href: "/securite" },
      { label: "Rapport de transparence", href: "/rapport-transparence" },
      { label: "À propos", href: "/a-propos" },
    ],
  },
  {
    title: "Service",
    links: [
      { label: "FAQ", href: "/faq" },
      { label: "Contact", href: "/contact" },
      { label: "SAV", href: "/connexion" },
      { label: "Demande devis pro", href: "/devis-pro" },
    ],
  },
  {
    title: "Légal",
    links: [
      { label: "Mentions légales", href: "/mentions-legales" },
      { label: "CGV", href: "/cgv" },
      { label: "Politique de confidentialité (RGPD)", href: "/confidentialite" },
      { label: "Conditions de garantie", href: "/garantie" },
      { label: "Politique de cookies", href: "/cookies" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <Container size="xl">
    <div class="footer__grid">
      <div class="footer__brand">
        <p class="footer__brand-name">ALARTIC</p>
        <p class="footer__brand-tagline">
          Smartphones durcis. Vie privée. Souveraineté.
        </p>
      </div>

      {columns.map((col) => (
        <div class="footer__col">
          <h3 class="footer__col-title">{col.title}</h3>
          <ul class="footer__col-list">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="footer__col-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer__bar">
      <p class="footer__copyright">© {year} ALARTIC. Tous droits réservés.</p>
      <p class="footer__disclaimer">
        Pixel et Google sont des marques de Google LLC. ALARTIC n'est pas affiliée à Google.
      </p>
    </div>
  </Container>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-accent);
    padding-block: var(--space-8) var(--space-6);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.5fr repeat(4, 1fr);
    }
  }

  .footer__brand-name {
    font-weight: var(--fw-bold);
    font-size: var(--fs-lg);
    letter-spacing: var(--tracking-wider);
  }
  .footer__brand-tagline {
    margin-top: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--fs-sm);
    max-width: 28ch;
  }

  .footer__col-title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }
  .footer__col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .footer__col-link {
    font-size: var(--fs-sm);
    color: var(--color-text);
  }
  .footer__col-link:hover {
    color: var(--color-brand);
  }

  .footer__bar {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
  @media (min-width: 768px) {
    .footer__bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
