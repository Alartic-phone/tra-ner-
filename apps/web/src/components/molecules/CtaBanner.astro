---
/**
 * CtaBanner — bandeau d'appel à l'action large, fond contrasté.
 * Variantes ink (sombre) ou brand (vert) selon le contexte.
 */

import Button from "../atoms/Button.astro";

interface Props {
  variant?: "sky" | "brand" | "ink";
  eyebrow?: string;
  title: string;
  description?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  variant = "sky",
  eyebrow,
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<div class:list={["cta", `cta--${variant}`]}>
  <div class="cta__content">
    {eyebrow && <p class="cta__eyebrow">{eyebrow}</p>}
    <h2 class="cta__title">{title}</h2>
    {description && <p class="cta__description">{description}</p>}
  </div>
  <div class="cta__actions">
    <a href={primaryHref} class="cta__btn cta__btn--primary">{primaryLabel}</a>
    {secondaryLabel && secondaryHref && (
      <a href={secondaryHref} class="cta__btn cta__btn--secondary">{secondaryLabel}</a>
    )}
  </div>
</div>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-2xl);
  }

  @media (min-width: 900px) {
    .cta {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: var(--space-8) var(--space-9);
      gap: var(--space-7);
    }
  }

  .cta--sky {
    background: linear-gradient(135deg, #8aa8c4 0%, #5e7d9a 100%);
    color: #ffffff;
  }

  .cta--brand {
    background-color: var(--color-brand);
    color: var(--color-text-on-brand);
  }

  .cta--ink {
    background-color: var(--color-text);
    color: var(--color-text-on-inverse);
  }

  .cta__content {
    flex: 1;
    max-width: 50ch;
  }

  .cta__eyebrow {
    font-size: var(--fs-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: var(--fw-medium);
    margin-bottom: var(--space-3);
  }
  .cta--sky .cta__eyebrow {
    color: rgba(255, 255, 255, 0.85);
  }
  .cta--brand .cta__eyebrow {
    color: var(--color-accent-soft);
  }

  .cta__title {
    font-size: var(--fs-3xl);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
    color: inherit;
    margin: 0;
  }

  .cta__description {
    margin-top: var(--space-3);
    font-size: var(--fs-md);
    opacity: 0.75;
    max-width: 50ch;
  }

  .cta__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-full);
    font-weight: var(--fw-medium);
    font-size: var(--fs-base);
    line-height: 1;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }

  .cta__btn--primary {
    background-color: var(--color-accent);
    color: var(--color-text);
  }
  .cta__btn--primary:hover {
    background-color: var(--color-accent-hover);
    color: var(--color-text-on-brand);
  }

  /* Sur la variante sky, le bouton primary doit être assorti au camaïeu bleu :
   * blanc avec texte bleu profond — clean et matching. */
  .cta--sky .cta__btn--primary {
    background-color: #ffffff;
    color: #3a5a78;
  }
  .cta--sky .cta__btn--primary:hover {
    background-color: #eef3f8;
    color: #2c4566;
  }

  .cta__btn--secondary {
    background-color: transparent;
    color: inherit;
    border-color: currentColor;
    opacity: 0.85;
  }
  .cta__btn--secondary:hover {
    opacity: 1;
    color: inherit;
  }
</style>
