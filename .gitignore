# Dépendances
node_modules/

# Build
dist/
.astro/
build/

# Environnement et secrets
.env
.env.local
.env.*.local
.env.production
*.key
*.pem
*.age
secrets/

# OS
.DS_Store
Thumbs.db

# Éditeurs
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*

# Cache
.cache/
.tmp/

# Scripts de debug jetables
debug/
# ... sauf apps/coach/src/app/debug/ : ce ne sont pas des scripts jetables
# mais des routes Next.js versionnées (pages de référence du système de
# design), cf. apps/coach/CLAUDE.md — un sous-projet autonome que les
# conventions racine n'atteignent pas.
!apps/coach/src/app/debug/
!apps/coach/src/app/debug/**

# Claude Code — uniquement les settings persos (settings.json et hooks restent versionnés)
.claude/settings.local.json

# Prévisualisation statique (générée par tools/preview)
.preview-build/
.preview-report.json
dist-preview/
dist-preview-bundle.html

# Sauvegardes ponctuelles de base SQLite (ex. avant restauration manuelle,
# nommées "dev.db.avant-...-<horodatage>.bak") — jamais dans git, même règle
# que prisma/*.db.
*.bak
