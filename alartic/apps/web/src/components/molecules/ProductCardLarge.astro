---
/**
 * ProductCardLarge — carte produit grand format style Apple "Explorez la gamme".
 * Image angled, nom, tagline, prix. Toute la carte est cliquable
 * (pattern "stretched link" : le <a> autour du nom couvre la carte via ::before).
 */

import Badge from "../atoms/Badge.astro";

interface Props {
  slug: string;
  name: string;
  tagline: string;
  priceFrom: number;
  image: string;
  imageAlt: string;
  isNew?: boolean;
  variantColors?: string[]; /* hex codes pour les pastilles */
}

const {
  slug,
  name,
  tagline,
  priceFrom,
  image,
  imageAlt,
  isNew = false,
  variantColors = [],
} = Astro.props;

const priceFormatted = new Intl.NumberFormat("fr-FR", {
  style: "currency",
  currency: "EUR",
  maximumFractionDigits: 0,
}).format(priceFrom);

/* Les modèles XL ont un écran 6,8" vs 6,3" sur les autres. On scale
 * l'image à 108% pour refléter physiquement la différence de taille. */
const isXL = slug.endsWith("-xl");
/* Tablette : format paysage, rester centré (le flex-end créerait un
 * décalage visuel inadapté à l'orientation horizontale). */
const isTablet = slug.includes("tablet");
---

<article class:list={[
  "product-card",
  isXL && "product-card--xl",
  isTablet && "product-card--tablet",
]}>
  <div class="product-card__media">
    <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
  </div>

  {variantColors.length > 0 && (
    <div class="product-card__variants" aria-label={`${variantColors.length} couleurs disponibles`}>
      {variantColors.map((hex) => (
        <span class="product-card__variant-dot" style={`background-color: ${hex}`} aria-hidden="true"></span>
      ))}
    </div>
  )}

  <div class="product-card__body">
    {isNew && <Badge variant="accent" size="sm">Nouveau</Badge>}
    <h3 class="product-card__name">
      <a href={`/modeles/${slug}`} class="product-card__link">{name}</a>
    </h3>
    <p class="product-card__tagline">{tagline}</p>
    <p class="product-card__price">
      À partir de <strong>{priceFormatted}</strong>
    </p>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-elevated);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    cursor: pointer;
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .product-card:hover .product-card__name {
    color: var(--color-brand);
  }

  /* Focus visible déclenché par le <a> stretched */
  .product-card:has(.product-card__link:focus-visible) {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 4px;
  }

  /* Stretched link : le <a> couvre toute la carte via ::before
   * sans wrapper invalide en HTML/a11y. */
  .product-card__link {
    color: inherit;
    text-decoration: none;
  }
  .product-card__link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .product-card__link:focus {
    outline: none;
  }

  .product-card__media {
    aspect-ratio: 4 / 5;
    display: flex;
    /* Toutes les images alignées au bas du conteneur → les XL dépassent
     * naturellement en haut sans casser la baseline. */
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--radius-xl);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
  }

  .product-card__media img {
    max-height: 80%;
    width: auto;
    object-fit: contain;
    transition: transform var(--duration-base) var(--ease-out);
  }

  /* Modèles XL : écran 6,8" → +8% pour refléter la différence physique
   * avec les modèles 6,3". Origin bottom : le bas reste aligné avec les
   * autres images, seul le haut dépasse. */
  .product-card--xl .product-card__media img {
    transform: scale(1.08);
    transform-origin: center bottom;
  }
  /* Tablette : format paysage, rester centrée verticalement. */
  .product-card--tablet .product-card__media {
    align-items: center;
    padding-bottom: 0;
  }

  .product-card__variants {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    margin-bottom: var(--space-4);
  }
  .product-card__variant-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }

  .product-card__name {
    font-size: var(--fs-2xl);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-tight);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .product-card__tagline {
    color: var(--color-text-secondary);
    font-size: var(--fs-md);
    max-width: 22ch;
    margin: 0;
  }

  .product-card__price {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }
  .product-card__price strong {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
  }
</style>
