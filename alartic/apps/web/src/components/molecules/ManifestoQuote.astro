---
/**
 * ManifestoQuote — citation pleine largeur du manifeste, style éditorial.
 * Met en valeur une phrase forte avec lien vers le manifeste complet.
 */

import Button from "../atoms/Button.astro";

interface Props {
  quote: string;
  attribution?: string;
  href?: string;
}

const {
  quote,
  attribution = "Extrait du manifeste ALARTIC",
  href = "/manifeste",
} = Astro.props;
---

<figure class="quote">
  <blockquote class="quote__text">
    <p data-anim="typewriter">{quote}</p>
  </blockquote>
  <figcaption class="quote__attr">{attribution}</figcaption>
  <div class="quote__cta">
    <Button href={href} variant="link" size="md">Lire le manifeste complet</Button>
  </div>
</figure>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    max-width: 56rem;
    position: relative;
  }

  .quote::before {
    content: "“";
    position: absolute;
    top: -0.35em;
    left: -0.1em;
    font-family: var(--font-serif);
    font-size: 8rem;
    line-height: 1;
    color: var(--color-brand);
    opacity: 0.15;
    pointer-events: none;
  }

  .quote__text {
    margin: 0;
    padding: 0;
  }

  .quote__text p {
    font-family: var(--font-serif);
    font-size: var(--fs-3xl);
    font-weight: var(--fw-medium);
    line-height: var(--lh-snug);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
    max-width: none;
    margin: 0;
    text-wrap: balance;
  }

  .quote__attr {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: var(--fw-medium);
  }

  .quote__cta {
    margin-top: var(--space-2);
  }
</style>
