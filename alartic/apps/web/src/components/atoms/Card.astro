---
interface Props {
  variant?: "elevated" | "outlined" | "accent";
  padding?: "none" | "sm" | "md" | "lg";
  as?: string;
  class?: string;
}

const {
  variant = "elevated",
  padding = "md",
  as: Tag = "div",
  class: className = "",
} = Astro.props;
---

<Tag class:list={["card", `card--${variant}`, `card--p-${padding}`, className]}>
  <slot />
</Tag>

<style>
  .card {
    border-radius: var(--radius-xl);
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .card--elevated {
    background-color: var(--color-bg-elevated);
    box-shadow: var(--shadow-sm);
  }
  .card--outlined {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
  }
  .card--accent {
    background-color: var(--color-bg-accent);
  }

  .card--p-none { padding: 0; }
  .card--p-sm   { padding: var(--space-4); }
  .card--p-md   { padding: var(--space-5); }
  .card--p-lg   { padding: var(--space-6); }

  @media (min-width: 768px) {
    .card--p-md { padding: var(--space-6); }
    .card--p-lg { padding: var(--space-7); }
  }
</style>
