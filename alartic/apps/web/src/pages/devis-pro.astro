---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Container from "../components/atoms/Container.astro";
import Badge from "../components/atoms/Badge.astro";
import Header from "../components/molecules/Header.astro";
import Footer from "../components/molecules/Footer.astro";

const API_BASE = import.meta.env.DEV ? "http://localhost:3000" : "/api";

const products = (await getCollection("products"))
  .filter((p) => p.data.available)
  .sort((a, b) => a.data.order - b.data.order);

const productData = products.map((p) => ({
  slug: p.id,
  name: p.data.name,
  colors: p.data.colors.map((c) => ({
    slug: c.slug,
    name: c.name,
    hex: c.hex,
    // Vue arrière privilégiée (cohérence avec /panier — ProductBuyBox passe
    // rearImage ?? frontImage à cart.add()), fallback vue avant si rearImage
    // pas défini dans le frontmatter.
    image: c.rearImage ?? c.frontImage,
  })),
  storages: p.data.storages.map((s) => ({ slug: s.slug, label: s.label, price: s.price })),
}));
---

<Base
  title="Demander un devis pro"
  description="Devis volume pour 5 unités minimum — Pixel sous GrapheneOS scellés. Mix possible : modèles, couleurs et stockages différents."
  noindex
>
  <Header slot="header" />

  <section class="quote">
    <Container size="md">
      <header class="quote__head">
        <Badge variant="brand" size="sm">B2B · 5 unités minimum (total)</Badge>
        <h1 class="quote__title">Demander un devis pro.</h1>
        <p class="quote__lead">
          Pour les commandes en volume (équipes, cabinets, rédactions, ONG), nous établissons un
          devis personnalisé avec tarif équipe, facturation professionnelle et accompagnement
          onboarding adapté. Mixez les modèles, coloris et stockages selon les besoins de votre équipe.
        </p>
      </header>

      <form id="quote-form" class="quote__form" novalidate>
        <section class="quote__section">
          <header class="quote__section-head">
            <h2 class="quote__h2">Articles</h2>
            <p class="quote__section-hint">
              Mixez les modèles, coloris et stockages. Total minimum :
              <strong>5 unités</strong>.
            </p>
          </header>

          <ul id="items-list" class="items"></ul>

          <div class="items__footer">
            <button type="button" id="add-item" class="items__add">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              Ajouter un modèle
            </button>
            <div class="items__total" id="items-total-wrap">
              Total : <strong id="items-total">0</strong>&nbsp;unité<span data-plural>(s)</span>
            </div>
          </div>
        </section>

        <section class="quote__section">
          <header class="quote__section-head">
            <h2 class="quote__h2">Société</h2>
          </header>
          <div class="quote__grid">
            <div class="quote__field quote__field--full">
              <label for="company_name">Raison sociale</label>
              <input id="company_name" name="company_name" type="text" required maxlength="120" autocomplete="organization" />
            </div>
            <div class="quote__field quote__field--full">
              <label for="siret">SIRET <span class="quote__hint">14 chiffres</span></label>
              <input id="siret" name="siret" type="text" required pattern="[0-9]{14}" maxlength="14" inputmode="numeric" />
            </div>
          </div>
        </section>

        <section class="quote__section">
          <header class="quote__section-head">
            <h2 class="quote__h2">Contact</h2>
          </header>
          <div class="quote__grid">
            <div class="quote__field">
              <label for="contact_name">Nom complet</label>
              <input id="contact_name" name="contact_name" type="text" required maxlength="60" autocomplete="name" />
            </div>
            <div class="quote__field">
              <label for="phone">Téléphone <span class="quote__hint">optionnel</span></label>
              <input id="phone" name="phone" type="tel" maxlength="30" autocomplete="tel" />
            </div>
            <div class="quote__field quote__field--full">
              <label for="email">Email professionnel</label>
              <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" />
            </div>
          </div>
        </section>

        <section class="quote__section">
          <header class="quote__section-head">
            <h2 class="quote__h2">Précisions</h2>
            <p class="quote__section-hint">Optionnel — échéance, modifications matérielles, contraintes spécifiques.</p>
          </header>
          <div class="quote__field quote__field--full">
            <label for="message" class="quote__sr">Message</label>
            <textarea id="message" name="message" rows="5" maxlength="5000" placeholder="Ex : déploiement à mi-juin, suppression du micro sur les unités équipe enquête, formation onboarding groupée en présentiel à Paris…"></textarea>
          </div>
        </section>

        <section class="quote__section quote__section--cta">
          <div class="quote__honey" aria-hidden="true">
            <label for="website">Ne pas remplir</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <label class="quote__checkbox">
            <input id="consent" name="consent" type="checkbox" required />
            <span>
              J'accepte que les informations transmises soient utilisées pour
              traiter ma demande, conformément à la
              <a href="/confidentialite" target="_blank">politique de confidentialité</a>.
            </span>
          </label>

          <p id="quote-error" class="quote__error" hidden></p>
          <p id="quote-success" class="quote__success" hidden>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="9 12 11 14 16 9"></polyline>
            </svg>
            Merci. Votre demande a bien été enregistrée. Nous revenons vers vous sous 48h ouvrées avec un devis détaillé.
          </p>

          <button type="submit" id="quote-submit" class="quote__submit">
            Envoyer la demande
          </button>

          <p class="quote__secure">
            Délai de réponse : <strong>48h ouvrées</strong> · Urgence :
            <a href="mailto:pro@alartic.fr">pro@alartic.fr</a>
          </p>
        </section>
      </form>
    </Container>
  </section>

  <Footer slot="footer" />
</Base>

<script define:vars={{ API_BASE, productData }}>
  // @ts-nocheck
  const MIN_TOTAL = 5;
  const MAX_ITEMS = 20;

  function nextItemId() {
    nextItemId.n = (nextItemId.n || 0) + 1;
    return nextItemId.n;
  }

  function createItemRow({ productSlug = "", colorSlug = "", storageSlug = "", quantity = 1 } = {}) {
    const id = nextItemId();
    const li = document.createElement("li");
    li.className = "item-row";
    li.dataset.itemId = id;
    li.innerHTML = `
      <div class="item-row__media" data-media>
        <div class="item-row__media-placeholder" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
            <line x1="12" y1="18" x2="12" y2="18"></line>
          </svg>
        </div>
        <img data-media-img alt="" hidden />
      </div>
      <div class="item-row__body">
        <div class="item-row__selects">
          <div class="item-row__field item-row__field--product">
            <label for="item-${id}-product">Modèle</label>
            <select id="item-${id}-product" data-field="product_slug" required>
              <option value="">— Modèle —</option>
              ${productData.map((p) => `<option value="${p.slug}">${p.name}</option>`).join("")}
            </select>
          </div>
          <div class="item-row__field">
            <label for="item-${id}-color">Coloris</label>
            <select id="item-${id}-color" data-field="color_slug" required disabled>
              <option value="">—</option>
            </select>
          </div>
          <div class="item-row__field">
            <label for="item-${id}-storage">Stockage</label>
            <select id="item-${id}-storage" data-field="storage_slug" required disabled>
              <option value="">—</option>
            </select>
          </div>
        </div>
      </div>
      <div class="item-row__qty">
        <label class="item-row__qty-label" for="item-${id}-qty">Quantité</label>
        <div class="qty-stepper">
          <button type="button" class="qty-stepper__btn" data-qty-dec aria-label="Diminuer">−</button>
          <input id="item-${id}-qty" data-field="quantity" type="number" min="1" max="999" value="${quantity}" required />
          <button type="button" class="qty-stepper__btn" data-qty-inc aria-label="Augmenter">+</button>
        </div>
      </div>
      <button type="button" class="item-row__remove" data-action="remove" aria-label="Supprimer cette ligne">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    `;

    const productSel = li.querySelector('[data-field="product_slug"]');
    const colorSel = li.querySelector('[data-field="color_slug"]');
    const storageSel = li.querySelector('[data-field="storage_slug"]');
    const qtyInput = li.querySelector('[data-field="quantity"]');
    const mediaImg = li.querySelector('[data-media-img]');
    const mediaPlaceholder = li.querySelector('.item-row__media-placeholder');

    function updateMedia() {
      const p = productData.find((x) => x.slug === productSel.value);
      const c = p ? p.colors.find((x) => x.slug === colorSel.value) : null;
      if (c && c.image) {
        mediaImg.src = c.image;
        mediaImg.alt = `${p.name} ${c.name}`;
        mediaImg.hidden = false;
        mediaPlaceholder.hidden = true;
      } else {
        mediaImg.hidden = true;
        mediaPlaceholder.hidden = false;
      }
    }

    function fillVariants(slug, preserveColor = "", preserveStorage = "") {
      const p = productData.find((x) => x.slug === slug);
      colorSel.innerHTML = "";
      storageSel.innerHTML = "";
      if (!p) {
        colorSel.disabled = true;
        storageSel.disabled = true;
        colorSel.appendChild(new Option("—", ""));
        storageSel.appendChild(new Option("—", ""));
        updateMedia();
        return;
      }
      colorSel.disabled = false;
      storageSel.disabled = false;
      colorSel.appendChild(new Option("— Coloris —", ""));
      p.colors.forEach((c) => colorSel.appendChild(new Option(c.name, c.slug)));
      storageSel.appendChild(new Option("— Stockage —", ""));
      p.storages.forEach((s) => storageSel.appendChild(new Option(`${s.label} · ${s.price} €`, s.slug)));
      if (preserveColor) colorSel.value = preserveColor;
      if (preserveStorage) storageSel.value = preserveStorage;
      updateMedia();
    }

    productSel.addEventListener("change", () => fillVariants(productSel.value));
    colorSel.addEventListener("change", updateMedia);
    qtyInput.addEventListener("input", updateTotal);

    li.querySelector("[data-qty-dec]").addEventListener("click", () => {
      const v = Math.max(1, (parseInt(qtyInput.value || "0", 10) || 0) - 1);
      qtyInput.value = String(v);
      updateTotal();
    });
    li.querySelector("[data-qty-inc]").addEventListener("click", () => {
      const v = Math.min(999, (parseInt(qtyInput.value || "0", 10) || 0) + 1);
      qtyInput.value = String(v);
      updateTotal();
    });

    // Pre-fill si on passe des slugs au constructeur.
    if (productSlug) {
      productSel.value = productSlug;
      fillVariants(productSlug, colorSlug, storageSlug);
    }
    return li;
  }

  function refreshRemoveButtons() {
    const items = document.querySelectorAll("#items-list .item-row");
    items.forEach((row) => {
      const btn = row.querySelector("[data-action='remove']");
      btn.disabled = items.length <= 1;
    });
  }

  function updateTotal() {
    let total = 0;
    document.querySelectorAll("#items-list .item-row").forEach((row) => {
      const q = parseInt(row.querySelector("[data-field='quantity']").value || "0", 10);
      if (q > 0) total += q;
    });
    document.getElementById("items-total").textContent = String(total);
    document.querySelector("[data-plural]").textContent = total > 1 ? "s" : "";
    const wrap = document.getElementById("items-total-wrap");
    if (wrap) {
      wrap.classList.toggle("items__total--ok", total >= MIN_TOTAL);
      wrap.classList.toggle("items__total--short", total > 0 && total < MIN_TOTAL);
    }
  }

  function addItem(prefill) {
    const list = document.getElementById("items-list");
    if (list.children.length >= MAX_ITEMS) return;
    list.appendChild(createItemRow(prefill || {}));
    refreshRemoveButtons();
    updateTotal();
  }

  function showError(msg) {
    const el = document.getElementById("quote-error");
    el.textContent = msg;
    el.hidden = false;
    el.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  function messageFromError(code) {
    switch (code) {
      case "consent_required": return "Vous devez accepter la politique de confidentialité.";
      case "siret_invalid": return "Le SIRET doit contenir 14 chiffres.";
      case "quantity_too_low": return "Total minimum : 5 unités (somme de toutes les lignes).";
      case "unknown_variant": return "Une variante est inconnue — vérifiez modèle / coloris / stockage de chaque ligne.";
      case "empty_items": return "Ajoutez au moins une ligne.";
      case "too_many_items": return "Vous ne pouvez pas demander plus de 20 lignes — contactez-nous directement à pro@alartic.fr.";
      default:
        if (code && code.length > 0 && code.length < 250) {
          return `Validation : ${code}`;
        }
        return "Une erreur est survenue. Vérifiez vos informations et réessayez.";
    }
  }

  // ───────── Init ─────────

  document.getElementById("add-item").addEventListener("click", () => addItem());

  document.getElementById("items-list").addEventListener("click", (e) => {
    const removeBtn = e.target.closest("[data-action='remove']");
    if (!removeBtn) return;
    const row = removeBtn.closest(".item-row");
    if (!row) return;
    if (document.querySelectorAll("#items-list .item-row").length <= 1) return;
    row.remove();
    refreshRemoveButtons();
    updateTotal();
  });

  function readCart() {
    try {
      const raw = localStorage.getItem("alartic.cart.v1");
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  }

  // Pré-fill — trois sources, par ordre de priorité :
  //   1. Query string depuis fiche produit (?product=...&color=...&storage=...&qty=N)
  //   2. Panier localStorage (depuis /panier qui redirige si total >= 5)
  //   3. Ligne vide par défaut
  (function prefill() {
    const params = new URLSearchParams(window.location.search);
    const product = params.get("product");
    const color = params.get("color");
    const storage = params.get("storage");
    const qtyRaw = params.get("qty");

    if (product && productData.find((p) => p.slug === product)) {
      let qty = 1;
      if (qtyRaw && /^\d+$/.test(qtyRaw)) {
        const n = parseInt(qtyRaw, 10);
        if (n >= 1 && n <= 999) qty = n;
      }
      addItem({ productSlug: product, colorSlug: color || "", storageSlug: storage || "", quantity: qty });
      return;
    }

    const cartItems = readCart();
    if (cartItems.length > 0) {
      cartItems.forEach((it) => {
        if (productData.find((p) => p.slug === it.productSlug)) {
          addItem({
            productSlug: it.productSlug,
            colorSlug: it.colorSlug || "",
            storageSlug: it.storageSlug || "",
            quantity: Math.max(1, Math.min(999, it.qty || 1)),
          });
        }
      });
      // Sécurité : si aucune ligne n'a pu être créée (panier obsolète /
      // slugs renommés), on tombe sur une ligne vide.
      if (document.querySelectorAll("#items-list .item-row").length === 0) {
        addItem();
      }
      return;
    }

    addItem();
  })();

  document.getElementById("quote-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    document.getElementById("quote-error").hidden = true;
    document.getElementById("quote-success").hidden = true;

    const btn = document.getElementById("quote-submit");
    btn.disabled = true;
    btn.textContent = "Envoi en cours…";

    // Collecte des items depuis le DOM.
    const items = [];
    let totalQty = 0;
    document.querySelectorAll("#items-list .item-row").forEach((row) => {
      const product_slug = row.querySelector("[data-field='product_slug']").value;
      const color_slug = row.querySelector("[data-field='color_slug']").value;
      const storage_slug = row.querySelector("[data-field='storage_slug']").value;
      const quantity = parseInt(row.querySelector("[data-field='quantity']").value || "0", 10);
      if (!product_slug || !color_slug || !storage_slug || !quantity) return; // ligne incomplète, skip
      items.push({ product_slug, color_slug, storage_slug, quantity });
      totalQty += quantity;
    });

    if (items.length === 0) {
      showError("Ajoutez au moins une ligne complète (modèle + coloris + stockage + quantité).");
      btn.disabled = false;
      btn.textContent = "Envoyer la demande";
      return;
    }
    if (totalQty < MIN_TOTAL) {
      showError(`Total minimum : ${MIN_TOTAL} unités. Vous avez ${totalQty}.`);
      btn.disabled = false;
      btn.textContent = "Envoyer la demande";
      return;
    }

    const fd = new FormData(e.target);
    const body = {
      items,
      email: String(fd.get("email") || "").trim(),
      contact_name: String(fd.get("contact_name") || "").trim(),
      company_name: String(fd.get("company_name") || "").trim(),
      siret: String(fd.get("siret") || "").trim(),
      phone: String(fd.get("phone") || "").trim() || null,
      message: String(fd.get("message") || "").trim() || null,
      website: String(fd.get("website") || ""),
      consent: fd.get("consent") === "on",
    };

    try {
      const r = await fetch(`${API_BASE}/devis-pro`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      if (!r.ok) {
        const err = await r.json().catch(() => ({}));
        console.error("[devis-pro] erreur API", r.status, err);
        showError(messageFromError(err.error || ""));
        btn.disabled = false;
        btn.textContent = "Envoyer la demande";
        return;
      }
      document.getElementById("quote-success").hidden = false;
      e.target.reset();
      // Reset des items aussi
      document.getElementById("items-list").innerHTML = "";
      addItem();
      btn.disabled = false;
      btn.textContent = "Envoyer la demande";
      window.scrollTo({ top: 0, behavior: "smooth" });
    } catch {
      showError("Erreur réseau. Veuillez réessayer.");
      btn.disabled = false;
      btn.textContent = "Envoyer la demande";
    }
  });
</script>

<style is:global>
  /* Le repeater d'items est injecté via innerHTML → les styles internes
   * doivent rester non-scoped (sinon le hash Astro ne se propage pas). */

  .quote {
    padding-block: var(--space-7) var(--space-9);
    background-color: var(--color-bg-accent);
    min-height: 70vh;
  }
  .quote__head {
    margin-bottom: var(--space-6);
    max-width: 65ch;
  }
  .quote__title {
    font-size: var(--fs-3xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
    margin: var(--space-3) 0 var(--space-4);
  }
  .quote__lead {
    font-size: var(--fs-md);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    margin: 0;
  }

  .quote__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* ───── Sections ───── */
  .quote__section {
    padding: var(--space-6);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }
  .quote__section--cta {
    background-color: var(--color-bg);
  }
  .quote__section-head {
    margin-bottom: var(--space-4);
  }
  .quote__h2 {
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    margin: 0;
  }
  .quote__section-hint {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    margin: var(--space-2) 0 0;
    line-height: var(--lh-relaxed);
  }
  .quote__section-hint strong {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
  }

  /* ───── Generic fields ───── */
  .quote__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  @media (max-width: 720px) {
    .quote__grid {
      grid-template-columns: 1fr;
    }
  }
  .quote__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .quote__field--full { grid-column: 1 / -1; }
  .quote__field label,
  .quote__sr {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
  }
  .quote__sr {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .quote__field input,
  .quote__field select,
  .quote__form textarea {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    font-family: inherit;
    font-size: var(--fs-md);
    color: var(--color-text);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .quote__form textarea {
    resize: vertical;
    min-height: 100px;
  }
  .quote__field input:focus,
  .quote__field select:focus,
  .quote__form textarea:focus {
    outline: none;
    border-color: var(--color-brand);
  }
  .quote__hint {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    font-weight: var(--fw-regular);
    text-transform: none;
    letter-spacing: normal;
  }
  .quote__checkbox {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    cursor: pointer;
  }
  .quote__checkbox input { margin-top: 2px; flex-shrink: 0; }
  .quote__checkbox a { color: var(--color-text); text-decoration: underline; }
  .quote__honey {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ───── Submit / feedback ───── */
  .quote__section--cta {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .quote__error {
    padding: var(--space-3) var(--space-4);
    background-color: color-mix(in srgb, var(--color-danger) 8%, transparent);
