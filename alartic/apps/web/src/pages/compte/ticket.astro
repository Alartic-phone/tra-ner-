---
import Base from "../../layouts/Base.astro";
import Container from "../../components/atoms/Container.astro";
import Card from "../../components/atoms/Card.astro";
import Header from "../../components/molecules/Header.astro";
import Footer from "../../components/molecules/Footer.astro";

// SSG : on ne peut pas faire de route dynamique sans `getStaticPaths`. On lit
// l'ID en query string côté client (?id=<uuid>) et on fetch /me/tickets/:id.
// API_BASE est défini côté <script type="module"> (import.meta.env.DEV).
---

<Base
  title="Ticket SAV"
  description="Détail d'un ticket de support ALARTIC."
  noindex
>
  <Header slot="header" />

  <section class="ticket-page">
    <Container>
      <a href="/compte" class="ticket-page__back">← Retour à mon compte</a>

      <div id="ticket-content">
        <p class="account__muted">Chargement…</p>
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</Base>

<script>
  // @ts-nocheck — code DOM permissif, à typer dans une future session de polish.
  import { alertDialog } from "../../scripts/dialogs";

  const API_BASE = import.meta.env.DEV ? "http://localhost:3000" : "/api";
  let abortCtl;
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => abortCtl?.abort());

  async function init() {
    abortCtl?.abort();
    abortCtl = new AbortController();
    const signal = abortCtl.signal;

    const root = document.getElementById("ticket-content");
    if (!root) return;

    const params = new URL(window.location.href).searchParams;
    const id = params.get("id");
    if (!id || !/^[0-9a-f-]{36}$/i.test(id)) {
      root.innerHTML = '<p class="account__muted">Ticket introuvable.</p>';
      return;
    }

    const r = await fetch(`${API_BASE}/me/tickets/${id}`, {
      credentials: "include",
    });
    if (r.status === 401) {
      window.location.href = "/connexion";
      return;
    }
    if (r.status === 404) {
      root.innerHTML = '<p class="account__muted">Ticket introuvable.</p>';
      return;
    }
    if (!r.ok) {
      root.innerHTML = '<p class="account__muted">Erreur de chargement.</p>';
      return;
    }
    const ticket = await r.json();
    render(ticket);
    bind(ticket, signal);
  }

  function getCsrf() {
    const m = document.cookie.match(/(?:^|; )alartic_csrf=([^;]+)/);
    return m ? decodeURIComponent(m[1]) : null;
  }

  function render(t) {
    const root = document.getElementById("ticket-content");
    root.innerHTML = `
      <header class="ticket-page__head">
        <div>
          <p class="ticket-page__crumb">${labelCategory(t.category)}</p>
          <h1 class="ticket-page__title">${escapeHtml(t.subject)}</h1>
          <p class="ticket-page__meta">
            Créé ${formatDate(t.created_at)} ·
            Mis à jour ${formatDate(t.updated_at)}
          </p>
        </div>
        <span class="ticket-row__status status--${escapeAttr(t.status)}">
          ${labelStatus(t.status)}
        </span>
      </header>

      <section class="thread" aria-label="Conversation">
        ${t.messages.map((m) => renderMessage(t.id, m)).join("")}
      </section>

      ${
        t.status === "closed"
          ? '<p class="ticket-page__closed">Ce ticket est clos. Pour relancer un échange, créez un nouveau ticket.</p>'
          : `
        <section class="reply-card">
          <h2 class="reply-card__title">Répondre</h2>
          <form id="reply-form" class="reply" novalidate>
            <textarea
              name="body"
              minlength="5"
              maxlength="10000"
              rows="5"
              required
              placeholder="Votre réponse…"
              class="reply__textarea"
            ></textarea>
            <div class="reply__bottom">
              <label class="reply__file-label">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                </svg>
                <input type="file" name="attachment" accept="image/png,image/jpeg,image/webp,application/pdf,text/plain" hidden />
                <span class="reply__file-name">Joindre un fichier</span>
              </label>
              <button type="submit" class="account__btn account__btn--primary">
                Envoyer
              </button>
            </div>
            <p id="reply-error" class="status-banner status-banner--error" hidden></p>
            <p class="account__muted reply__hint">
              5 MB max. PNG, JPEG, WebP, PDF, TXT. Tout est chiffré au repos.
            </p>
          </form>
        </section>
      `
      }
    `;
  }

  function renderMessage(ticketId, m) {
    const isAdmin = m.sender === "admin";
    const senderLabel = isAdmin ? "ALARTIC SAV" : "Vous";
    const initial = isAdmin ? "A" : "V";
    const attachmentsHtml =
      m.attachments && m.attachments.length > 0
        ? `<ul class="msg__attachments">${m.attachments
            .map(
              (a) => `
              <li class="attach-pill">
                <span class="attach-pill__icon" aria-hidden="true">${mimeIcon(a.mime_type)}</span>
                <div class="attach-pill__meta">
                  <span class="attach-pill__name">${escapeHtml(a.filename)}</span>
                  <span class="attach-pill__size">${formatSize(a.size_bytes)}</span>
                </div>
                <button
                  type="button"
                  class="attach-pill__btn"
                  data-ticket-id="${escapeAttr(ticketId)}"
                  data-download-id="${escapeAttr(a.id)}"
                  data-filename="${escapeHtml(a.filename)}"
                  aria-label="Télécharger ${escapeHtml(a.filename)}"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                </button>
              </li>
            `
            )
            .join("")}</ul>`
        : "";

    return `
      <article class="msg ${isAdmin ? "msg--admin" : "msg--user"}">
        <div class="msg__avatar" aria-hidden="true">${initial}</div>
        <div class="msg__bubble">
          <header class="msg__head">
            <span class="msg__sender">${senderLabel}</span>
            <time class="msg__date">${formatDateTime(m.created_at)}</time>
          </header>
          <p class="msg__body">${escapeHtml(m.body).replace(/\n/g, "<br>")}</p>
          ${attachmentsHtml}
        </div>
      </article>
    `;
  }

  function mimeIcon(mime) {
    if (mime.startsWith("image/"))
      return '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>';
    if (mime === "application/pdf")
      return '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>';
    return '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>';
  }

  function bind(ticket, signal) {
    // Download des attachments — via fetch + blob pour porter le cookie.
    document.querySelectorAll("[data-download-id]").forEach((btn) => {
      btn.addEventListener(
        "click",
        () => downloadAttachment(ticket.id, btn.dataset.downloadId, btn.dataset.filename),
        { signal }
      );
    });

    const form = document.getElementById("reply-form");
    if (form) {
      form.addEventListener("submit", (e) => submitReply(e, ticket.id), { signal });
      // Affiche le nom du fichier sélectionné dans le label.
      const fileInput = form.querySelector('input[type="file"]');
      const label = form.querySelector(".reply__file-name");
      if (fileInput && label) {
        fileInput.addEventListener(
          "change",
          () => {
            const f = fileInput.files?.[0];
            label.textContent = f ? f.name : "Joindre un fichier";
          },
          { signal }
        );
      }
    }
  }

  async function downloadAttachment(ticketId, attachId, filename) {
    const r = await fetch(
      `${API_BASE}/me/tickets/${ticketId}/attachments/${attachId}`,
      { credentials: "include" }
    );
    if (!r.ok) {
      await alertDialog({
        title: "Téléchargement échoué",
        body: "Le fichier n'a pas pu être récupéré. Réessayez ou contactez le SAV.",
        variant: "error",
      });
      return;
    }
    const blob = await r.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename || "attachment";
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  async function submitReply(e, ticketId) {
    e.preventDefault();
    const form = e.target;
    const errEl = document.getElementById("reply-error");
    errEl.hidden = true;
    const csrf = getCsrf();

    const body = form.body.value.trim();
    if (body.length < 5) {
      errEl.textContent = "Message trop court (≥ 5 caractères).";
      errEl.hidden = false;
      return;
    }

    const r = await fetch(`${API_BASE}/me/tickets/${ticketId}/messages`, {
      method: "POST",
      credentials: "include",
      headers: { "Content-Type": "application/json", "X-CSRF-Token": csrf },
      body: JSON.stringify({ body }),
    });
    if (!r.ok) {
      errEl.textContent =
        r.status === 404
          ? "Ticket introuvable ou clos."
          : "Échec de l'envoi du message.";
      errEl.hidden = false;
      return;
    }
    const { id: messageId } = await r.json();

    // Upload pièce jointe optionnelle, rattachée au message qu'on vient de créer.
    const file = form.attachment?.files?.[0];
    if (file) {
      if (file.size > 5 * 1024 * 1024) {
        errEl.textContent =
          "Message envoyé, mais la pièce jointe dépasse 5 MB et n'a pas été uploadée.";
        errEl.hidden = false;
      } else {
        const fd = new FormData();
        fd.append("file", file);
        const upload = await fetch(
          `${API_BASE}/me/tickets/${ticketId}/attachments?message_id=${encodeURIComponent(messageId)}`,
          {
            method: "POST",
            credentials: "include",
            headers: { "X-CSRF-Token": csrf },
            body: fd,
          }
        );
        if (!upload.ok) {
          errEl.textContent =
            "Message envoyé, mais l'upload de la pièce jointe a échoué (format non autorisé ?).";
          errEl.hidden = false;
        }
      }
    }

    // Recharge le ticket pour afficher le nouveau message + attachment.
    init();
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    })[c]);
  }
  function escapeAttr(s) {
    return String(s).replace(/[^a-z0-9_-]/gi, "");
  }
  function formatDate(iso) {
    return new Date(iso).toLocaleDateString("fr-FR", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });
  }
  function formatDateTime(iso) {
    return new Date(iso).toLocaleString("fr-FR", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }
  function formatSize(bytes) {
    if (bytes < 1024) return `${bytes} o`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} Ko`;
    return `${(bytes / 1024 / 1024).toFixed(1)} Mo`;
  }
  function labelCategory(c) {
    return (
      {
        question: "Question",
        probleme_technique: "Problème technique",
        garantie: "Garantie",
        autre: "Autre",
      }[c] || c
    );
  }
  function labelStatus(s) {
    return (
      {
        open: "Ouvert",
        in_progress: "En cours",
        waiting_user: "Attente client",
        resolved: "Résolu",
        closed: "Clos",
      }[s] || s
    );
  }
</script>

<style is:global>
  .ticket-page {
    padding-block: var(--space-9);
    background-color: var(--color-bg-accent);
    min-height: 70vh;
  }
  .ticket-page__back {
    display: inline-block;
    margin-bottom: var(--space-5);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--fs-sm);
  }
  .ticket-page__back:hover {
    color: var(--color-text);
  }
  .ticket-page__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
  .ticket-page__crumb {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: var(--fw-medium);
  }
  .ticket-page__title {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-3xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
  }
  .ticket-page__meta {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }

  /* ───────── Thread façon support pro ───────── */
  .thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .msg {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .msg__avatar {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
    color: var(--color-text);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
  }
  .msg--admin .msg__avatar {
    background-color: var(--color-brand);
    color: white;
    border-color: var(--color-brand);
  }
  .msg__bubble {
    flex: 1;
    min-width: 0;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
  }
  .msg--admin .msg__bubble {
    background-color: color-mix(in srgb, var(--color-brand) 6%, var(--color-bg));
    border-color: color-mix(in srgb, var(--color-brand) 25%, var(--color-border));
  }
  .msg__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }
  .msg__sender {
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
  }
  .msg__date {
    color: var(--color-text-muted);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }
  .msg__body {
    margin: 0;
    color: var(--color-text);
    line-height: var(--lh-relaxed);
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  /* ───────── Attachments en pastilles sous le message ───────── */
  .msg__attachments {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .attach-pill {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .attach-pill:hover {
    border-color: var(--color-text);
  }
  .attach-pill__icon {
    flex-shrink: 0;
    display: flex;
    color: var(--color-text-secondary);
  }
  .attach-pill__meta {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .attach-pill__name {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .attach-pill__size {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
  .attach-pill__btn {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }
  .attach-pill__btn:hover {
    background-color: var(--color-text);
    color: var(--color-text-on-inverse);
    border-color: var(--color-text);
  }

  /* ───────── Reply card ───────── */
  .reply-card {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background-color: var(--color-bg);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
  .reply-card__title {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
  }
  .reply {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .reply__textarea {
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: var(--fs-base);
    color: var(--color-text);
    background-color: var(--color-bg);
    resize: vertical;
    min-height: 100px;
  }
  .reply__textarea:focus {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 1px;
  }
  .reply__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .reply__file-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .reply__file-label:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }
  .reply__file-name {
    max-width: 240px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .reply__hint {
    margin: 0;
    font-size: var(--fs-xs);
  }
  .ticket-page__closed {
    margin-top: var(--space-6);
    padding: var(--space-4);
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    text-align: center;
  }
</style>
