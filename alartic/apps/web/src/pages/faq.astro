---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Container from "../components/atoms/Container.astro";
import Header from "../components/molecules/Header.astro";
import Footer from "../components/molecules/Footer.astro";
import CtaBanner from "../components/molecules/CtaBanner.astro";

const all = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);

const categoryOrder: Record<string, number> = {
  commande: 1,
  livraison: 2,
  garantie: 3,
  sav: 4,
  technique: 5,
  privacy: 6,
  general: 7,
};

const categoryLabel: Record<string, string> = {
  commande: "Commande & paiement",
  livraison: "Livraison",
  garantie: "Garantie",
  sav: "Service après-vente",
  technique: "Technique & GrapheneOS",
  privacy: "Vie privée",
  general: "Général",
};

const grouped = all.reduce<Record<string, typeof all>>((acc, item) => {
  const key = item.data.category;
  acc[key] = acc[key] ?? [];
  acc[key].push(item);
  return acc;
}, {});

const sortedGroups = Object.entries(grouped).sort(
  ([a], [b]) => (categoryOrder[a] ?? 99) - (categoryOrder[b] ?? 99),
);

/* Pré-render le body markdown pour chaque entrée */
const rendered = await Promise.all(
  sortedGroups.map(async ([cat, items]) => {
    const withBodies = await Promise.all(
      items.map(async (it) => {
        const { Content } = await render(it);
        return { item: it, Content };
      }),
    );
    return { cat, items: withBodies };
  }),
);
---

<Base
  title="FAQ"
  description="Questions fréquentes : produits, commande, garantie, SAV, vie privée."
>
  <Header slot="header" />

  <section class="hero">
    <Container size="lg">
      <div data-anim="hero-stagger">
        <h1 class="hero__title">Les questions qu'on nous pose souvent.</h1>
        <p class="hero__lead">
          Si la vôtre n'est pas ici, écrivez-nous : on répond personnellement, sous 24 h
          ouvrées, sans chatbot.
        </p>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container size="md">
      {rendered.map((group) => (
        <div class="faq-group">
          <h2 class="faq-group__title">{categoryLabel[group.cat] ?? group.cat}</h2>
          <div class="faq-list">
            {group.items.map(({ item, Content }, i) => (
              <details class="faq-item" open={i === 0}>
                <summary class="faq-item__question">
                  <span>{item.data.question}</span>
                  <svg class="faq-item__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </summary>
                <div class="faq-item__answer">
                  <Content />
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </Container>
  </section>

  <section class="section">
    <Container size="xl">
      <CtaBanner
        variant="sky"
        eyebrow="Votre question n'est pas là ?"
        title="On répond en moins de 24 h."
        description="Email humain, sans script générique. Si vous hésitez avant d'acheter, on prend le temps."
        primaryLabel="Nous écrire"
        primaryHref="/contact"
        secondaryLabel="Voir la gamme"
        secondaryHref="/modeles"
      />
    </Container>
  </section>

  <Footer slot="footer" />
</Base>

<script>
  import "../scripts/animations";
</script>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-7);
    background-color: var(--color-bg);
  }
  .hero__title {
    font-size: var(--fs-4xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
    margin: var(--space-4) 0 var(--space-4);
    max-width: 22ch;
  }
  .hero__lead {
    font-size: var(--fs-lg);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    max-width: 56ch;
  }

  .section {
    padding-block: var(--space-9);
  }

  .faq-group {
    margin-bottom: var(--space-8);
  }
  .faq-group:last-child {
    margin-bottom: 0;
  }
  .faq-group__title {
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-brand);
    display: inline-block;
  }

  .faq-list {
    border-top: 1px solid var(--color-border);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }
  .faq-item__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-5) 0;
    cursor: pointer;
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
    gap: var(--space-4);
    list-style: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .faq-item__question::-webkit-details-marker { display: none; }
  .faq-item__question:hover { color: var(--color-brand); }
  .faq-item__chevron {
    flex-shrink: 0;
    color: var(--color-text-secondary);
    transition: transform var(--duration-base) var(--ease-out);
  }
  .faq-item[open] .faq-item__chevron {
    transform: rotate(180deg);
    color: var(--color-brand);
  }

  .faq-item__answer {
    padding-bottom: var(--space-5);
    padding-right: var(--space-7);
    color: var(--color-text-secondary);
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
  }
  .faq-item__answer :global(p) {
    margin: 0 0 var(--space-3);
    max-width: 65ch;
  }
  .faq-item__answer :global(p:last-child) {
    margin-bottom: 0;
  }
  .faq-item__answer :global(strong) {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
  }
  .faq-item__answer :global(a) {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .faq-item__answer :global(code) {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background-color: var(--color-bg-subtle);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }
</style>
