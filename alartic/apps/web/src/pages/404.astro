---
import Base from "../layouts/Base.astro";
import Container from "../components/atoms/Container.astro";
import Button from "../components/atoms/Button.astro";
import Header from "../components/molecules/Header.astro";
import Footer from "../components/molecules/Footer.astro";
---

<Base
  title="Page introuvable"
  description="Cette page n'existe pas — peut-être qu'elle a été déplacée."
  noindex
>
  <Header slot="header" />

  <section class="not-found">
    <Container size="md">
      <p class="not-found__code">404</p>
      <h1 class="not-found__title">Page introuvable.</h1>
      <p class="not-found__lead">
        Cette URL ne correspond à rien sur notre site. Soit la page a été déplacée, soit elle
        n'a jamais existé, soit vous avez tapé un peu vite.
      </p>

      <div class="not-found__cta">
        <Button href="/" variant="primary" size="lg">Retour à l'accueil</Button>
        <Button href="/modeles" variant="link" size="lg">Voir la gamme</Button>
      </div>

      <div class="not-found__suggestions">
        <p class="not-found__suggestions-title">Vous cherchiez peut-être :</p>
        <ul>
          <li><a href="/modeles">Les Pixel disponibles</a></li>
          <li><a href="/manifeste">Le manifeste</a></li>
          <li><a href="/faq">Les questions fréquentes</a></li>
          <li><a href="/compatibilite">La compatibilité applicative</a></li>
          <li><a href="/contact">Nous écrire</a></li>
        </ul>
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .not-found {
    padding-block: var(--space-9) var(--space-9);
    text-align: left;
    background-color: var(--color-bg);
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  .not-found__code {
    font-family: var(--font-serif);
    font-size: clamp(5rem, 4rem + 6vw, 9rem);
    font-weight: var(--fw-bold);
    line-height: 1;
    color: var(--color-brand);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }
  .not-found__title {
    font-size: var(--fs-4xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
    margin: var(--space-3) 0 var(--space-4);
  }
  .not-found__lead {
    font-size: var(--fs-lg);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    max-width: 56ch;
  }
  .not-found__cta {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  .not-found__suggestions {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .not-found__suggestions-title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    margin: 0 0 var(--space-3);
  }
  .not-found__suggestions ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .not-found__suggestions a {
    font-size: var(--fs-md);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .not-found__suggestions a:hover {
    color: var(--color-brand);
  }
</style>
