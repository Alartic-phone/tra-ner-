---
import Base from "../layouts/Base.astro";
import Container from "../components/atoms/Container.astro";
import Card from "../components/atoms/Card.astro";
import Header from "../components/molecules/Header.astro";
import Footer from "../components/molecules/Footer.astro";

const API_BASE = import.meta.env.DEV ? "http://localhost:3000" : "/api";
---

<Base
  title="Contact"
  description="Posez-nous une question. Réponse humaine sous 24 h ouvrées, sans chatbot."
>
  <Header slot="header" />

  <section class="hero">
    <Container size="lg">
      <div data-anim="hero-stagger">
        <h1 class="hero__title">Écrivez-nous.</h1>
        <p class="hero__lead">
          Pas de chatbot. Pas de service client externalisé. Pas de script. Vous posez votre
          question, on répond personnellement sous <strong>24 h ouvrées</strong>.
        </p>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container size="lg">
      <div class="layout">
        <Card variant="elevated" padding="lg" class="form-card">
          <div id="contact-form-wrap">
          <form
            class="form"
            id="contact-form"
            data-contact-form
            novalidate
            aria-label="Formulaire de contact"
          >
            <div class="form__row">
              <label for="type" class="form__label">Type de demande</label>
              <select
                id="type"
                name="type"
                class="form__select"
                required
                data-prefill="type"
              >
                <option value="general">Question générale</option>
                <option value="produit">Question sur un produit</option>
                <option value="sav">Service après-vente</option>
                <option value="pro">Demande de devis pro</option>
                <option value="presse">Presse / interview</option>
                <option value="securite">Signalement de sécurité</option>
              </select>
            </div>

            <div class="form__row">
              <label for="email" class="form__label">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                class="form__input"
                required
                autocomplete="email"
                placeholder="vous@exemple.fr"
              />
            </div>

            <div class="form__row">
              <label for="subject" class="form__label">Sujet</label>
              <input
                type="text"
                id="subject"
                name="subject"
                class="form__input"
                required
                minlength="3"
                maxlength="120"
                data-prefill-context="subject"
              />
            </div>

            <div class="form__row">
              <label for="message" class="form__label">Message</label>
              <textarea
                id="message"
                name="message"
                class="form__textarea"
                required
                minlength="10"
                maxlength="5000"
                rows="6"
                placeholder="Soyez précis, on vous répondra mieux."
                data-prefill-context="message"
              ></textarea>
            </div>

            <!-- Honeypot anti-spam — invisible aux humains, rempli par les bots.
                 CDC §5.4 : pas de Google reCAPTCHA. -->
            <div class="form__honeypot" aria-hidden="true">
              <label for="website">Laissez ce champ vide</label>
              <input
                type="text"
                id="website"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="form__consent">
              <label class="form__checkbox">
                <input type="checkbox" name="consent" required />
                <span>
                  J'accepte que mes données soient utilisées uniquement pour traiter cette
                  demande, conformément à la
                  <a href="/confidentialite">Politique de confidentialité</a>.
                </span>
              </label>
            </div>

            <button type="submit" class="form__submit" id="contact-submit">
              Envoyer
            </button>

            <p id="contact-msg" class="form__msg" hidden></p>
          </form>
          </div>
        </Card>

        <aside class="sidebar">
          <h2 class="sidebar__title">Adresses directes</h2>
          <dl class="sidebar__list">
            <div>
              <dt>Général</dt>
              <dd><a href="mailto:contact@alartic.fr">contact@alartic.fr</a></dd>
            </div>
            <div>
              <dt>SAV</dt>
              <dd><a href="mailto:sav@alartic.fr">sav@alartic.fr</a></dd>
            </div>
            <div>
              <dt>Devis pro</dt>
              <dd><a href="mailto:pro@alartic.fr">pro@alartic.fr</a></dd>
            </div>
            <div>
              <dt>RGPD</dt>
              <dd><a href="mailto:rgpd@alartic.fr">rgpd@alartic.fr</a></dd>
            </div>
            <div>
              <dt>Sécurité (PGP)</dt>
              <dd><a href="mailto:security@alartic.fr">security@alartic.fr</a></dd>
            </div>
          </dl>

          <h2 class="sidebar__title">Engagements</h2>
          <ul class="sidebar__pledges">
            <li>Réponse sous 24 h ouvrées.</li>
            <li>Pas de chatbot. Pas de réponse générique.</li>
            <li>Données chiffrées, supprimées après 12 mois.</li>
            <li>PGP disponible pour les sujets sensibles.</li>
          </ul>
        </aside>
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</Base>

<script>
  import "../scripts/animations";
</script>

<script define:vars={{ API_BASE }}>
  let abortCtl;
  document.addEventListener("astro:page-load", setupContact);
  document.addEventListener("astro:before-swap", () => abortCtl?.abort());

  function setupContact() {
    abortCtl?.abort();
    abortCtl = new AbortController();
    const signal = abortCtl.signal;

    const form = document.getElementById("contact-form");
    const btn = document.getElementById("contact-submit");
    const msg = document.getElementById("contact-msg");
    const wrap = document.getElementById("contact-form-wrap");
    if (!form || !btn || !msg || !wrap) return;

    form.addEventListener(
      "submit",
      async (e) => {
        e.preventDefault();
        msg.hidden = true;
        msg.classList.remove("form__msg--error");

        const payload = {
          type: form.type.value,
          email: form.email.value.trim(),
          subject: form.subject.value.trim(),
          message: form.message.value.trim(),
          website: form.website.value, // honeypot
          consent: form.consent.checked,
        };
        if (!payload.consent) {
          showError(
            "Vous devez accepter la politique de confidentialité pour envoyer."
          );
          return;
        }

        btn.disabled = true;
        btn.textContent = "Envoi…";

        try {
          const r = await fetch(`${API_BASE}/contact`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          if (r.ok) {
            renderSuccess();
          } else if (r.status === 400) {
            showError(
              "Données invalides. Vérifiez votre email, le sujet (3+) et le message (10+)."
            );
          } else {
            showError("Une erreur est survenue. Réessayez dans un instant.");
          }
        } catch (err) {
          showError("Impossible de joindre le serveur. Vérifiez votre connexion.");
        }
      },
      { signal }
    );

    function renderSuccess() {
      wrap.innerHTML = `
        <div class="form__success">
          <h2 class="form__success-title">Message envoyé.</h2>
          <p class="form__success-lead">
            Nous vous répondrons sous <strong>24 h ouvrées</strong> à l'adresse
            que vous avez fournie. Pas de chatbot, pas de réponse générique.
          </p>
          <p class="form__success-hint">
            Vous pouvez fermer cet onglet.
          </p>
        </div>
      `;
    }

    function showError(text) {
      msg.hidden = false;
      msg.textContent = text;
      msg.classList.add("form__msg--error");
      btn.disabled = false;
      btn.textContent = "Envoyer";
    }
  }
</script>

<style>
  .form__msg {
    margin: var(--space-3) 0 0;
    font-size: var(--fs-sm);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-accent);
    border: 1px solid var(--color-border);
  }
  .form__msg--error {
    color: #b91c1c;
    background-color: #fef2f2;
    border-color: #fecaca;
  }
  .form__success {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-accent);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .form__success-title {
    margin: 0;
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
  }
  .form__success-lead {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
  }
  .form__success-hint {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
</style>

<script>
  /* Pré-remplit le formulaire depuis les query string (utilisé par le buy button
   * en mode devis pro). Ex: /contact?type=pro&product=pixel-10-pro&qty=10&color=obsidian&storage=256go */
  const params = new URLSearchParams(window.location.search);
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form && params.size > 0) {
    /* type */
    const type = params.get("type");
    if (type) {
      const typeSelect = form.querySelector<HTMLSelectElement>('[data-prefill="type"]');
      if (typeSelect && Array.from(typeSelect.options).some((o) => o.value === type)) {
        typeSelect.value = type;
      }
    }

    /* Compose un sujet + message contextualisé */
    const product = params.get("product");
    const color = params.get("color");
    const storage = params.get("storage");
    const qty = params.get("qty");

    if (product) {
      const subjectInput = form.querySelector<HTMLInputElement>('[data-prefill-context="subject"]');
      const messageInput = form.querySelector<HTMLTextAreaElement>('[data-prefill-context="message"]');

      if (type === "pro") {
        if (subjectInput) subjectInput.value = `Demande de devis pro — ${product}`;
        if (messageInput) {
          messageInput.value =
            `Bonjour,\n\nJe souhaite obtenir un devis pro pour :\n` +
            `- Modèle : ${product}\n` +
            (color ? `- Couleur : ${color}\n` : "") +
            (storage ? `- Stockage : ${storage}\n` : "") +
            (qty ? `- Quantité : ${qty} unités\n` : "") +
            `\nMerci de me communiquer tarif, délai et conditions.\n\nCordialement,`;
        }
      } else {
        if (subjectInput) subjectInput.value = `Question — ${product}`;
      }
    }
  }
</script>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-7);
    background-color: var(--color-bg);
  }
  .hero__title {
    font-size: var(--fs-4xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
    margin: var(--space-4) 0 var(--space-4);
  }
  .hero__lead {
    font-size: var(--fs-lg);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    max-width: 60ch;
  }
  .hero__lead strong {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
  }

  .section {
    padding-block: var(--space-9);
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 2fr 1fr;
      gap: var(--space-8);
    }
  }

  /* ───────── Form ───────── */
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .form__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form__label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text);
    letter-spacing: var(--tracking-wide);
  }

  .form__input,
  .form__select,
  .form__textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: var(--fs-base);
    color: var(--color-text);
    background-color: var(--color-bg);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .form__input:hover,
  .form__select:hover,
  .form__textarea:hover {
    border-color: var(--color-border-strong);
  }
  .form__input:focus,
  .form__select:focus,
  .form__textarea:focus {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
    border-color: var(--color-brand);
  }
  .form__textarea {
    resize: vertical;
    min-height: 120px;
  }

  /* Honeypot caché visuellement mais accessible côté serveur */
  .form__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__consent {
    padding: var(--space-3);
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-md);
  }
  .form__checkbox {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    cursor: pointer;
  }
  .form__checkbox input {
    margin-top: 4px;
    flex-shrink: 0;
  }
  .form__checkbox a {
    color: var(--color-brand);
    text-decoration: underline;
  }

  .form__submit {
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-text);
    color: var(--color-text-on-inverse);
    border: 1px solid var(--color-text);
    border-radius: var(--radius-full);
    font-family: inherit;
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    cursor: pointer;
    transition: opacity var(--duration-fast) var(--ease-out);
    align-self: flex-start;
  }
  .form__submit:hover {
    opacity: 0.85;
  }

  .form__notice {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
    border-top: 1px dashed var(--color-border);
    padding-top: var(--space-3);
  }

  /* ───────── Sidebar ───────── */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .sidebar__title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3);
  }

  .sidebar__list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .sidebar__list > div {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-3);
  }
  .sidebar__list > div:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .sidebar__list dt {
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }
  .sidebar__list dd {
    margin: 0;
    font-size: var(--fs-sm);
  }
  .sidebar__list a {
    color: var(--color-text);
    text-decoration: none;
  }
  .sidebar__list a:hover {
    color: var(--color-brand);
  }

  .sidebar__pledges {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .sidebar__pledges li {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    position: relative;
    padding-left: var(--space-5);
  }
  .sidebar__pledges li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-success);
    font-weight: var(--fw-bold);
  }
</style>
