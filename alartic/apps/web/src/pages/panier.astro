---
import Base from "../layouts/Base.astro";
import Container from "../components/atoms/Container.astro";
import Header from "../components/molecules/Header.astro";
import Footer from "../components/molecules/Footer.astro";
---

<Base title="Panier" description="Votre panier ALARTIC." noindex>
  <Header slot="header" />

  <section class="cart-section">
    <Container size="xl">
      <div class="cart-layout" data-cart-root>
        <div class="cart-main">
          <h1 class="cart-main__title" data-cart-main-title hidden>
            <span>Détails de votre panier</span>
            <span class="cart-main__count" data-cart-head-count></span>
          </h1>
          <ul class="cart-list" data-cart-list></ul>
        </div>

        <div class="cart-empty" data-cart-empty hidden>
          <div class="cart-empty__icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
          </div>
          <h2 class="cart-empty__title">Votre panier est vide.</h2>
          <p class="cart-empty__lead">Découvrez la gamme et choisissez votre Pixel.</p>
          <a href="/modeles" class="cart-empty__cta">Voir les modèles →</a>
        </div>

        <div class="cart-side" data-cart-side hidden>
          <h2 class="cart-side__title">Récapitulatif</h2>
          <aside class="cart-summary" data-cart-summary>
          <ul class="cart-summary__list" data-cart-summary-list></ul>

          <div class="cart-summary__rows">
            <div class="cart-summary__row">
              <span>Sous-total</span>
              <span data-cart-subtotal>0 €</span>
            </div>
          </div>

          <div class="cart-summary__total">
            <span class="cart-summary__total-label">Total TTC</span>
            <span class="cart-summary__total-price" data-cart-total>0 €</span>
          </div>

          <p class="cart-summary__pro" data-cart-pro-notice hidden>
            <strong>5 unités ou plus ?</strong> Bénéficiez d'un devis pro à tarif équipe.
          </p>

          <button type="button" class="cart-summary__btn" data-cart-checkout>
            Continuer
          </button>

          <p class="cart-summary__legal">
            En passant commande, vous acceptez nos
            <a href="/cgv">Conditions générales de vente</a>
            et notre
            <a href="/confidentialite">Politique de confidentialité</a>.
          </p>

          <div class="cart-summary__payments" aria-label="Moyens de paiement acceptés">
            <span class="cart-summary__payments-item">CB</span>
            <span class="cart-summary__payments-item">Visa</span>
            <span class="cart-summary__payments-item">Mastercard</span>
            <span class="cart-summary__payments-item">PayPal</span>
          </div>

          <p class="cart-summary__secure">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Paiement sécurisé — aucune donnée bancaire stockée chez nous
          </p>

          <button type="button" class="cart-summary__clear" data-cart-clear hidden>
            Vider le panier
          </button>
          </aside>
        </div>
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</Base>

<script>
  import { cart, type CartItem } from "../scripts/cart";

  const fmt = new Intl.NumberFormat("fr-FR", {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 0,
  });

  function modsTags(mods: CartItem["mods"]): string[] {
    const tags: string[] = [];
    if (mods.mic) tags.push("Micro supprimé");
    if (mods.frontCam) tags.push("Caméra avant supprimée");
    if (mods.rearCam) tags.push("Caméra arrière supprimée");
    return tags;
  }

  function escape(s: string): string {
    return s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!
    );
  }

  function render() {
    const list = document.querySelector<HTMLUListElement>("[data-cart-list]");
    const empty = document.querySelector<HTMLElement>("[data-cart-empty]");
    const summary = document.querySelector<HTMLElement>("[data-cart-side]");
    const mainTitle = document.querySelector<HTMLElement>("[data-cart-main-title]");
    const subtotalEl = document.querySelector<HTMLElement>("[data-cart-subtotal]");
    const totalEl = document.querySelector<HTMLElement>("[data-cart-total]");
    const proNotice = document.querySelector<HTMLElement>("[data-cart-pro-notice]");
    const headCount = document.querySelector<HTMLElement>("[data-cart-head-count]");
    const summaryList = document.querySelector<HTMLUListElement>("[data-cart-summary-list]");
    const clearBtn = document.querySelector<HTMLElement>("[data-cart-clear]");
    if (!list || !empty || !summary || !subtotalEl || !totalEl || !summaryList) return;

    const items = cart.list();
    list.innerHTML = "";
    summaryList.innerHTML = "";

    if (items.length === 0) {
      empty.hidden = false;
      summary.hidden = true;
      list.hidden = true;
      if (mainTitle) mainTitle.hidden = true;
      if (headCount) headCount.textContent = "";
      if (clearBtn) clearBtn.hidden = true;
      return;
    }
    empty.hidden = true;
    summary.hidden = false;
    list.hidden = false;
    if (mainTitle) mainTitle.hidden = false;
    if (clearBtn) clearBtn.hidden = false;

    const totalQty = cart.count();
    if (headCount) {
      headCount.textContent = `${totalQty} article${totalQty > 1 ? "s" : ""}`;
    }

    items.forEach((it, i) => {
      const li = document.createElement("li");
      li.className = "cart-row";
      const tags = modsTags(it.mods);
      const tagsHtml = tags
        .map((t) => `<span class="cart-row__tag">${escape(t)}</span>`)
        .join("");

      const mediaHtml = it.colorImage
        ? `<img src="${escape(it.colorImage)}" alt="${escape(it.productName)} ${escape(it.colorName)}" loading="lazy" decoding="async" />`
        : `<div class="cart-row__media-fallback" aria-hidden="true"></div>`;

      li.innerHTML = `
        <a class="cart-row__media" href="/modeles/${escape(it.productSlug)}">${mediaHtml}</a>
        <div class="cart-row__body">
          <a class="cart-row__name" href="/modeles/${escape(it.productSlug)}">${escape(it.productName)} — ${escape(it.storageLabel)} — ${escape(it.colorName)}</a>
          ${tagsHtml ? `<div class="cart-row__tags">${tagsHtml}</div>` : ""}
        </div>
        <div class="cart-row__side">
          <div class="cart-row__price">${fmt.format(it.unitPrice * it.qty)}</div>
          ${it.qty > 1 ? `<div class="cart-row__price-unit">${fmt.format(it.unitPrice)} / unité</div>` : ""}
          <div class="cart-row__actions">
            <div class="cart-row__qty">
              <button type="button" class="cart-row__qty-btn" data-cart-qty-dec="${i}" aria-label="Réduire la quantité">−</button>
              <span class="cart-row__qty-value">${it.qty}</span>
              <button type="button" class="cart-row__qty-btn" data-cart-qty-inc="${i}" aria-label="Augmenter la quantité">+</button>
            </div>
            <button type="button" class="cart-row__remove" data-cart-remove="${i}">Supprimer</button>
          </div>
        </div>
      `;
      list.appendChild(li);

      /* ───────── Summary mini-line ───────── */
      const sli = document.createElement("li");
      sli.className = "cart-mini";
      sli.innerHTML = `
        <div class="cart-mini__media">
          ${
            it.colorImage
              ? `<img src="${escape(it.colorImage)}" alt="" loading="lazy" decoding="async" />`
              : ""
          }
        </div>
        <div class="cart-mini__info">
          <p class="cart-mini__name">${escape(it.productName)} — ${escape(it.colorName)} — ${escape(it.storageLabel)}</p>
          <p class="cart-mini__delivery">Livraison <span>Offerte</span></p>
        </div>
        <div class="cart-mini__price">${fmt.format(it.unitPrice * it.qty)}</div>
      `;
      summaryList.appendChild(sli);
    });

    const total = cart.total();
    subtotalEl.textContent = fmt.format(total);
    totalEl.textContent = fmt.format(total);
    if (proNotice) proNotice.hidden = totalQty < 5;
  }

  let controller: AbortController | null = null;

  function setup() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const root = document.querySelector<HTMLElement>("[data-cart-root]");
    if (!root) return;

    root.addEventListener(
      "click",
      (e) => {
        const target = e.target as HTMLElement;
        const decBtn = target.closest<HTMLElement>("[data-cart-qty-dec]");
        const incBtn = target.closest<HTMLElement>("[data-cart-qty-inc]");
        const rmBtn = target.closest<HTMLElement>("[data-cart-remove]");

        if (decBtn) {
          const i = Number(decBtn.dataset.cartQtyDec);
          const item = cart.list()[i];
          if (!item) return;
          if (item.qty <= 1) cart.remove(i);
          else cart.setQty(i, item.qty - 1);
        } else if (incBtn) {
          const i = Number(incBtn.dataset.cartQtyInc);
          const item = cart.list()[i];
          if (!item) return;
          cart.setQty(i, item.qty + 1);
        } else if (rmBtn) {
          const i = Number(rmBtn.dataset.cartRemove);
          cart.remove(i);
        }
      },
      { signal },
    );

    document.querySelector("[data-cart-clear]")?.addEventListener(
      "click",
      () => {
        if (cart.list().length === 0) return;
        if (confirm("Vider le panier ?")) cart.clear();
      },
      { signal },
    );

    document.querySelector("[data-cart-checkout]")?.addEventListener(
      "click",
      () => {
        const items = cart.list();
        if (items.length === 0) return;
        const totalQty = cart.count();
        if (totalQty >= 5) {
          window.location.href = "/devis-pro";
        } else {
          window.location.href = "/commander";
        }
      },
      { signal },
    );
  }

  document.addEventListener("astro:before-swap", () => controller?.abort());
  document.addEventListener("astro:page-load", () => {
    render();
    setup();
  });
  cart.onChange(render);
</script>

<style is:global>
  /* Styles du panier en global — le contenu des lignes est injecté par JS via
   * innerHTML et ne reçoit pas le hash de scoping Astro, donc on évite le
   * scoping pour que tout s'applique (Astro gotcha classique). */

  .cart-section {
    padding-block: var(--space-7) var(--space-9);
  }


  .cart-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 960px) {
    .cart-layout {
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: var(--space-7);
    }
  }

  /* ═════════ Main column ═════════ */
  .cart-main {
    min-width: 0;
  }
  .cart-main__title {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }
  .cart-main__count {
    font-size: var(--fs-sm);
    font-weight: var(--fw-regular);
    color: var(--color-text-secondary);
  }
  .cart-main__title[hidden] {
    display: none;
  }

  .cart-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .cart-list[hidden] {
    display: none;
  }

  /* ───────── Cart row ───────── */
  .cart-row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .cart-row:hover {
    border-color: var(--color-border-strong);
  }

  @media (min-width: 720px) {
    .cart-row {
      grid-template-columns: 110px minmax(0, 1fr) auto;
      gap: var(--space-5);
      padding: var(--space-5);
    }
  }

  /* Media */
  .cart-row__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--duration-base) var(--ease-out);
  }
  @media (min-width: 720px) {
    .cart-row__media {
      width: 110px;
      height: 110px;
    }
  }
  .cart-row__media:hover {
    transform: scale(1.03);
  }
  .cart-row__media img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .cart-row__media-fallback {
    width: 50%;
    aspect-ratio: 9 / 19;
    background-color: var(--color-bg-accent);
    border-radius: var(--radius-md);
  }

  /* Body */
  .cart-row__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .cart-row__name {
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    text-decoration: none;
    line-height: var(--lh-snug);
  }
  .cart-row__name:hover {
    color: var(--color-brand);
  }
  .cart-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cart-row__tag {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--space-2);
    background-color: var(--color-bg-subtle);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
  }

  /* Side (price + controls) */
  .cart-row__side {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 720px) {
    .cart-row__side {
      grid-column: auto;
      padding-top: 0;
      border-top: none;
      align-items: flex-end;
      min-width: 200px;
    }
  }

  .cart-row__price {
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    line-height: 1;
  }
  .cart-row__price-unit {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
  .cart-row__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .cart-row__qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background-color: var(--color-bg);
  }
  .cart-row__qty-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    font-size: var(--fs-md);
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .cart-row__qty-btn:hover {
    background-color: var(--color-bg-subtle);
  }
  .cart-row__qty-value {
    min-width: 28px;
    text-align: center;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }

  .cart-row__remove {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    height: 32px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .cart-row__remove:hover {
    border-color: var(--color-danger);
    color: var(--color-danger);
  }

  /* ═════════ Side (titre + box) ═════════ */
  .cart-side {
    position: sticky;
    top: calc(64px + var(--space-3));
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .cart-side[hidden] {
    display: none;
  }
  .cart-side__title {
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }

  .cart-summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .cart-summary__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .cart-mini {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
  }
  .cart-mini__media {
    position: relative;
    width: 48px;
    height: 48px;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .cart-mini__media img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .cart-mini__qty {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    background-color: var(--color-brand);
    color: var(--color-text-on-inverse);
    border-radius: var(--radius-full);
    font-size: 10px;
    font-weight: var(--fw-bold);
    line-height: 18px;
    text-align: center;
  }
  .cart-mini__info {
    min-width: 0;
  }
  .cart-mini__name {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text);
    margin: 0 0 2px;
    line-height: var(--lh-snug);
  }
  .cart-mini__delivery {
    font-size: var(--fs-xs);
    color: var(--color-text-secondary);
    margin: 0;
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .cart-mini__delivery span {
    color: var(--color-success);
    font-weight: var(--fw-medium);
  }
  .cart-mini__price {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    white-space: nowrap;
  }

  .cart-summary__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--fs-sm);
    color: var(--color-text);
  }
  .cart-summary__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: var(--space-3);
    margin-top: var(--space-1);
    border-top: 1px solid var(--color-border);
  }
  .cart-summary__total-label {
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
  }
  .cart-summary__total-price {
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
  }

  .cart-summary__pro {
    margin: 0;
    padding: var(--space-3);
    background-color: color-mix(in srgb, var(--color-brand) 8%, transparent);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    color: var(--color-text);
  }
  .cart-summary__pro strong {
    color: var(--color-brand);
    font-weight: var(--fw-semibold);
  }
  .cart-summary__pro[hidden] {
    display: none;
  }

  .cart-summary__btn {
    padding: var(--space-4);
    width: 100%;
    border: none;
    border-radius: var(--radius-md);
    background-color: var(--color-text);
    color: var(--color-text-on-inverse);
    font-family: inherit;
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    cursor: pointer;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .cart-summary__btn:hover {
    opacity: 0.85;
  }
  .cart-summary__btn:active {
    transform: scale(0.99);
  }

  .cart-summary__legal {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
    text-align: center;
  }
  .cart-summary__legal a {
    color: var(--color-text);
    text-decoration: underline;
  }

  .cart-summary__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }
  .cart-summary__payments-item {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--color-text-secondary);
    letter-spacing: var(--tracking-wide);
  }

  .cart-summary__secure {
    display: flex;
