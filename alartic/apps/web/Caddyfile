# Caddyfile ALARTIC — configuration de production
# Caddy est le reverse proxy qui sert le site et applique les headers de sécurité.
#
# Caddy gère automatiquement TLS (Let's Encrypt) — pas de configuration manuelle de certificats.
# Cette configuration vise SSL Labs A+ et Mozilla Observatory A+.
#
# Pour développer en local, utiliser `npm run dev` (ce fichier n'est pas utilisé en dev).

{
	# Email pour les notifications Let's Encrypt (à mettre à jour au déploiement)
	email security@alartic.fr

	# TLS 1.3 uniquement, suites fortes
	servers {
		protocols h1 h2 h3
	}
}

alartic.fr {
	# Redirige www vers la version sans www
	@www host www.alartic.fr
	redir @www https://alartic.fr{uri} permanent

	root * /var/www/alartic/dist
	encode zstd gzip
	file_server

	# ─────────────── Headers de sécurité ───────────────

	header {
		# HSTS — force HTTPS pendant 2 ans, preload list incluse
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

		# Empêche le navigateur de deviner les types MIME
		X-Content-Type-Options "nosniff"

		# Empêche l'inclusion du site dans une iframe (clickjacking)
		X-Frame-Options "DENY"

		# Politique de référent : ne fuit pas l'URL complète aux sites externes
		Referrer-Policy "strict-origin-when-cross-origin"

		# Désactive caméra, micro, géolocalisation, paiement, etc. par défaut
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"

		# CSP stricte : aucun script tiers, aucune ressource externe
		# 'self' couvre toutes les ressources du domaine
		# Les styles inline sont autorisés (Astro en utilise un peu)
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

		# Empêche XSS legacy (laissé pour les vieux navigateurs)
		X-XSS-Protection "0"

		# Enlève le header Server par défaut (info inutile pour un attaquant)
		-Server
	}

	# ─────────────── Cache & MIME ───────────────

	# Assets statiques avec hash : cache long
	@astro_assets path /_astro/*
	header @astro_assets Cache-Control "public, max-age=31536000, immutable"

	# Pages HTML : pas de cache long (contenu modifiable)
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# ─────────────── Logs ───────────────

	# Politique zero-log : on n'enregistre que les erreurs, pas les visites individuelles
	log {
		output file /var/log/caddy/alartic.log {
			roll_size 10mb
			roll_keep 7
			roll_keep_for 168h
		}
		level WARN
		# Pas de capture user-agent + referer + IP complète simultanément
	}

	# ─────────────── Reverse proxy vers le back-end Axum (J3+) ───────────────

	# Décommenter une fois le back-end Axum (Tokio + sqlx, cf. apps/api/) déployé
	# sur le port 3000.
	# handle_path /api/* {
	#     reverse_proxy localhost:3000 {
	#         header_up X-Real-IP {remote_host}
	#     }
	# }
}
